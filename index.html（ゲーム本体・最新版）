      </div>
    `).join("");
    const mq = mainQuestInfo();
    const mqHtml = `
      <div class="dq-win" style="margin-bottom:10px; background:#2a1e08; border:1px solid #f59e0b;">
        <div><strong>★メインクエスト：${mq.title}</strong></div>
        <div class="sub" style="margin-top:3px; color:#fde68a;">目的：${mq.obj}</div>
      </div>
    `;
    body.innerHTML = `${mqHtml}<div class="section-title">酒場の依頼一覧</div>${activeHtml}${listHtml}`;
  } else if (state.barSub === "bj") {
    const bj = state.bj; const hideDealerHole = bj.phase === "player";
    const dCardsHtml = bj.dealerCards.length ? bj.dealerCards.map((c, i) => renderCardHtml(c, hideDealerHole && i === 1)).join("") : `<span class="sub">カードなし</span>`;
    const pCardsHtml = bj.playerCards.length ? bj.playerCards.map(c => renderCardHtml(c, false)).join("") : `<span class="sub">カードなし</span>`;
    const pSum = bj.playerCards.length ? handScore(bj.playerCards) : 0;
    const dSumText = !bj.dealerCards.length ? "0" : (hideDealerHole ? `${bj.dealerCards[0].val} + ?` : `${handScore(bj.dealerCards)}`);

    let controls = "";
    if (bj.phase === "bet") {
      controls = `<div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:8px;"><button class="small" onclick="setBjBet(500)">¥500</button><button class="small" onclick="setBjBet(1000)">¥1,000</button><button class="small" onclick="setBjBet(3000)">¥3,000</button><button class="small" onclick="startBjRound()">勝負する（賭け金: ¥${bj.bet.toLocaleString()}）</button></div>`;
    } else if (bj.phase === "player") {
