                    size: Math.random() * 2.5 + 1,
                    speed: Math.random() * 40 + 20,
                    hue: Math.random() * 360
                });
            }
            this.tieDyeClouds = [];
            for (let i = 0; i < 6; i++) {
                this.tieDyeClouds.push({
                    x: Math.random() * this.width,
                    y: Math.random() * this.height,
                    radius: Math.random() * 110 + 70,
