function renderBuyerSellBlock(buyerId, buyerName, buyLimit, likes, buyPriceMap) {
  const sellableLikes = (likes || []).filter(k => ITEMS[k] && ITEMS[k].group !== "antique");
  if (sellableLikes.length === 0) return "";
  const rem = getNpcRemainingQuota(buyerId, buyLimit);
  const likeNames = sellableLikes.map(k => ITEMS[k].name).join(" / ");
  const rows = sellableLikes.map(k => {
    const have = state.bag[k] || 0; const maxSell = Math.min(have, rem);
    const price = buyPriceMap[k] || 1000; const qty = getQty("sell_" + buyerId + "_" + k, maxSell, 1);
    return `
      <div class="row">
        <div><div><strong>${ITEMS[k].name}</strong> を売る <span class="sub">買値 ¥${price.toLocaleString()}/個（所持:${have}）</span></div></div>
        <div style="display:flex; gap:4px; align-items:center;">
          ${qtyButtons("sell_" + buyerId + "_" + k, maxSell, 1)}
          <button class="small good" ${maxSell <= 0 ? "disabled" : ""} onclick="sellItemToBuyer('${buyerId}', '${buyerName}', ${buyLimit}, '${k}', ${price})">${rem <= 0 ? "上限到達" : `売る(¥${(price * Math.max(1, qty)).toLocaleString()})`}</button>
        </div>
      </div>
    `;
  }).join("");
  return `
    <div style="margin-top:8px; padding-top:6px; border-top:1px dashed rgba(255,255,255,0.2);">
      <div class="sub" style="color:#fde68a;"><strong>${buyerName}</strong>の好み：${likeNames}（残り購入枠: <strong>${rem}/${buyLimit}個</strong>）</div>
      ${rows}
    </div>
  `;
}

