function serializeGameState() {
  const d = {};
  for (const [k, v] of Object.entries(state)) {
    if (k === "dungeon") {
      d.dungeon = {};
      for (const [dk, dv] of Object.entries(v)) {
        d.dungeon[dk] = { ...dv, visited: [...(dv.visited || [])], collectedLoots: [...(dv.collectedLoots || [])], chests: { ...(dv.chests || {}) } };
      }
    } else {
      d[k] = v;
    }
  }
  return JSON.stringify(d);
}

function applySerializedState(json) {
  const d = JSON.parse(json);
  const curDungeon = state.dungeon;
  for (const k of Object.keys(d)) {
    if (k === "dungeon") continue;
    state[k] = d[k];
  }
  state.dungeon = {};
  for (const dk of Object.keys(curDungeon)) {
    const sv = (d.dungeon || {})[dk];
    if (sv) {
      state.dungeon[dk] = { ...sv, visited: new Set(sv.visited || []), collectedLoots: new Set(sv.collectedLoots || []), chests: sv.chests || {} };
    } else {
      state.dungeon[dk] = curDungeon[dk];
    }
  }
  if (!state.warehouseStock) state.warehouseStock = { herb_high: 60, supp_high: 60, supp_mid: 40, gold_watch: 2 };
  if (!Array.isArray(state.refiners)) state.refiners = [];
  if (typeof state.mainStage !== "number") state.mainStage = 0;
  if (typeof state.lastTastingText !== "string") state.lastTastingText = "";
}

