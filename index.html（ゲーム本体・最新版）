</script>
<script>
const TEST_MAX_HP = 999;

const ITEMS = {
  tonic:         { name: "救急ドリンク", group: "gear_misc", slot: "usable", shopBuy: 600, heal: 25, desc: "HPを25回復する（戦闘・探索・自宅で使える）。" },
  bento:         { name: "コンビニ弁当", group: "gear_misc", slot: "usable", shopBuy: 550, heal: 18, desc: "HPを18回復する（戦闘・探索・自宅で使える）。" },
