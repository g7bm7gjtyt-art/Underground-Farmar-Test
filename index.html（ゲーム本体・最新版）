function gainExp(amount) {
  if (amount <= 0) return "";
  state.exp += amount;
  let msg = `（+${amount} EXP）`;
  let leveled = false;
  while (state.exp >= expNeededForLevel(state.level)) {
    state.exp -= expNeededForLevel(state.level);
    state.level++;
    state.baseAtk += 2;
    state.maxHp += 25;
    state.carryMax += 10;
    state.hp = Math.min(state.maxHp, state.hp + 25);
    leveled = true;
    msg += ` ★レベルアップ！LV.${state.level}（ATK+2・最大HP+25・所持上限+10）`;
  }
  if (leveled) bgm.playSE("win");
  return msg;
}

