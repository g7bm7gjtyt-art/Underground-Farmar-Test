    const ownedKeys = Object.keys(ITEMS).filter(k => (state.bag[k] || 0) > 0 || (state.storage[k] || 0) > 0);
    const groups = [
      { title: "【装備品】", keys: ownedKeys.filter(k => ITEMS[k].slot === "weapon" || ITEMS[k].slot === "armor") },
      { title: "【持ち物】", keys: ownedKeys.filter(k => ITEMS[k].group === "gear_misc" && !["weapon", "armor", "seed"].includes(ITEMS[k].slot)) },
      { title: "【種】", keys: ownedKeys.filter(k => ITEMS[k].slot === "seed") },
      { title: "【品物】", keys: ownedKeys.filter(k => ITEMS[k].group === "goods") },
      { title: "【骨董品】", keys: ownedKeys.filter(k => ITEMS[k].group === "antique") }
    ];
    const html = `<div class="sub" style="margin-bottom:4px;">手持ち合計 ${totalCarried()} / ${state.carryMax}。出し入れは方向ごとに個数を選べる。</div>` + groups.map(g => {
      const rows = g.keys.map(k => {
        const bVal = state.bag[k] || 0; const sVal = state.storage[k] || 0;
        return `
          <div class="row" style="flex-direction:column; align-items:stretch; gap:4px;">
            <div><strong>${ITEMS[k].name}</strong> <span class="sub">手持ち:${bVal} ／ 倉庫:${sVal}</span></div>
            <div style="display:flex; gap:6px; align-items:center; justify-content:space-between;">
              <span class="sub">倉庫へ入れる</span>
              <span style="display:flex; gap:4px; align-items:center;">${qtyButtons("st_" + k + "_toStorage", bVal, 1)}<button class="small" ${bVal > 0 ? "" : "disabled"} onclick="moveStorage('${k}', 'toStorage')">→倉庫</button></span>
            </div>
            <div style="display:flex; gap:6px; align-items:center; justify-content:space-between;">
              <span class="sub">手持ちへ出す</span>
              <span style="display:flex; gap:4px; align-items:center;">${qtyButtons("st_" + k + "_toBag", Math.min(sVal, space), 1)}<button class="small" ${sVal > 0 && space > 0 ? "" : "disabled"} onclick="moveStorage('${k}', 'toBag')">←手持ち</button></span>
            </div>
          </div>
        `;
      }).join("");
      return `<div class="section-title">${g.title}</div>${rows || '<div class="sub" style="padding:6px 4px;">（まだ何もない。手に入れた物だけがここに表示される）</div>'}`;
    }).join("");
    body.innerHTML = html;
  } else if (state.homeSub === "memo") {
    const diaryInfo = getDiarySaveInfo();
    const diaryEntries = getDiaryEntries();
    const diaryRows = diaryEntries.map(e => `
      <div class="list-row" style="align-items:flex-start;">
        <div>
          <div>${escapeHtml(e.text)}</div>
          <div class="sub">${escapeHtml(e.date)} ／ ${e.turn}ターン ／ Lv.${e.lv} ／ ¥${Number(e.gold || 0).toLocaleString()}</div>
        </div>
      </div>`).join("");
    body.innerHTML = `
      <div class="section-title">メモ（自由記入・自動保存）</div>
      <div class="sub" style="margin-bottom:6px;">顧客情報など自由に書けるメモ。入力するとその場で自動保存される（ゲームのセーブとは別に、この端末へ保存）。</div>
      <textarea id="memoText" rows="10" oninput="saveMemoText(this.value)" style="width:100%; box-sizing:border-box; background:#0b1124; color:#e2e8f0; border:1px solid #334155; border-radius:8px; padding:8px;" placeholder="例：カイ＝特上ハーブ・高級サプリ／ゲン＝幻のハーブ¥4,600／クドウ＝奥地・上限20">${escapeHtml(loadMemoText())}</textarea>
      <div class="section-title" style="margin-top:14px;">栽培日誌（手動セーブ）</div>
      <div class="sub" style="margin-bottom:6px;">日誌をつけると、その時点の状態が手動セーブされる。タイトル画面の「📖 栽培日記からはじめる」や下のボタンで戻れる（セーブは常に最新の1件）。</div>
      <textarea id="diaryText" rows="3" style="width:100%; box-sizing:border-box; background:#0b1124; color:#e2e8f0; border:1px solid #334155; border-radius:8px; padding:8px;" placeholder="今日の栽培メモ…"></textarea>
      <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px;">
        <button onclick="saveDiaryEntry()">📖 日誌をつけてセーブ</button>
        ${diaryInfo ? `<button onclick="loadDiarySave()">${loadDiaryArmed ? "⚠ 本当にこの時点に戻る？（もう一度押す）" : "この時点に戻る"}</button>` : ""}
      </div>
      ${diaryInfo ? `<div class="sub" style="margin-top:6px;">現在の日誌セーブ：${diaryInfo.turn}ターン ／ Lv.${diaryInfo.level} ／ ¥${Number(diaryInfo.gold || 0).toLocaleString()}</div>` : `<div class="sub" style="margin-top:6px;">（日誌セーブはまだない）</div>`}
      ${diaryRows ? `<div style="margin-top:8px;">${diaryRows}</div>` : ""}
    `;
  }}

const BRIBE_AMOUNT = 400000;

function warehouseStockTotal() { return Object.values(state.warehouseStock).reduce((a, b) => a + b, 0); }

function mainQuestInfo() {
  switch (state.mainStage) {
    case 0: return { title: "第1章：小銭稼ぎの日々", obj: "酒場の「情報交換」で ★大きな仕事の噂 を聞く" };
    case 1: return { title: "第2章：カードキーを追え", obj: "貧民窟B3Fの北壁ドアから「B3-管理室」に入り、カードキーを手に入れる" };
    case 2: return { title: "第3章：プラント屋へ", obj: "地下街（8,0）のプラント屋にカードキーで入店し、種と栽培設備を揃える" };
    case 3: return { title: "第4章：買収資金を貯めろ", obj: "¥" + BRIBE_AMOUNT.toLocaleString() + " を貯めて、地下街（10,7）ヤクザの倉庫の倉庫番を買収する（現在 ¥" + state.gold.toLocaleString() + "）" };
    case 4: return { title: "最終章：倉庫を空にしろ", obj: "ヤクザの倉庫の在庫をすべて持ち出す（残り " + warehouseStockTotal() + " 個）" };
    default: return { title: "クリア済み", obj: "メインクエスト達成！そのまま裏の街で自由に暮らせる" };
  }
}

function hearMainRumor() {
  if (state.mainStage !== 0) return;
  state.mainStage = 1;
  state.lastInfoText = "【大きな仕事の噂】地下街にはカードキーが無いと入れないプラント屋があり、種と栽培設備を扱っているらしい。カードキーは貧民窟B3F最深部の管理室に残されているとか。さらに、ヤクザの倉庫（地下街の南東）には大量のハーブとサプリが眠っているという……。";
  bgm.playSE("confirm");
  log("大きな仕事の噂を聞いた！★メインクエストが進んだ（進捗は酒場の「依頼」で確認できる）");
  render();
}

function bribeWarehouseGuard() {
  if (state.warehouseBribed) return;
  if (state.gold < BRIBE_AMOUNT) { bgm.playSE("error"); log("所持金が足りない（買収には ¥" + BRIBE_AMOUNT.toLocaleString() + " 必要／現在 ¥" + state.gold.toLocaleString() + "）。"); return; }
  state.gold -= BRIBE_AMOUNT;
  state.warehouseBribed = true;
  state.mainStage = Math.max(state.mainStage, 4);
  advanceTurns(1);
  bgm.playSE("win");
  log("倉庫番に ¥" + BRIBE_AMOUNT.toLocaleString() + " を渡した。倉庫番：「……中身、好きに持っていけ。俺は何も見てない。」★倉庫の在庫を持ち出せるようになった！");
  render(); drawDungeon3D();
}

function takeWarehouseItem(itemKey) {
  const stock = state.warehouseStock[itemKey] || 0;
  if (stock <= 0) { bgm.playSE("error"); log("その在庫はもう無い。"); return; }
  const space = state.carryMax - totalCarried();
  if (space <= 0) { bgm.playSE("error"); log("手持ち枠がいっぱいだ。"); return; }
  const qty = getQty("wh_" + itemKey, Math.min(stock, space), 1);
  if (qty <= 0) { bgm.playSE("error"); log("持ち出せる数が無い。"); return; }
  state.warehouseStock[itemKey] -= qty;
  state.bag[itemKey] = (state.bag[itemKey] || 0) + qty;
  advanceTurns(1);
  bgm.playSE("loot");
  log("倉庫から " + ITEMS[itemKey].name + " を " + qty + "個 持ち出した（残り在庫 " + warehouseStockTotal() + " 個）。");
  if (warehouseStockTotal() <= 0 && !state.endingShown) {
    state.mainStage = 5;
    state.endingShown = true;
    render(); drawDungeon3D();
    showEndingScreen();
    return;
  }
  render(); drawDungeon3D();
}

function showEndingScreen() {
  const el = document.getElementById("endingScreen");
  if (!el) return;
  const st = document.getElementById("endingStats");
  if (st) st.textContent = "到達記録：LV." + state.level + " ／ " + state.turn + "ターン経過 ／ 所持金 ¥" + state.gold.toLocaleString();
  el.style.display = "block";
  document.body.classList.add("title-open");
  syncCurrentBgmMode();
}

function closeEndingScreen() {
  const el = document.getElementById("endingScreen");
  if (el) el.style.display = "none";
  document.body.classList.remove("title-open");
  bgm.playSE("confirm");
  syncCurrentBgmMode();
  log("メインクエスト達成！そのまま裏の街での暮らしを続けられる。");
  render();
}

