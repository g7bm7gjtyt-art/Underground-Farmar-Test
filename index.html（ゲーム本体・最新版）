  ctx.fillStyle = "rgba(0,0,0,0.35)";
  ctx.beginPath(); ctx.ellipse(cx, baseY + 2, w * 0.55, 5 * scale, 0, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = "#92400e";
  ctx.fillRect(x, y + h * 0.35, w, h * 0.65);
  ctx.fillStyle = "#b45309";
  ctx.beginPath(); ctx.moveTo(x, y + h * 0.35); ctx.quadraticCurveTo(cx, y - h * 0.25, x + w, y + h * 0.35); ctx.closePath(); ctx.fill();
  ctx.fillStyle = "#f59e0b";
  ctx.fillRect(x, y + h * 0.32, w, 3.5 * scale);
  ctx.fillRect(cx - 2 * scale, y, 4 * scale, h);
  ctx.fillStyle = "#fbbf24";
  ctx.fillRect(cx - 5 * scale, y + h * 0.38, 10 * scale, 9 * scale);
  ctx.fillStyle = "#78350f";
  ctx.beginPath(); ctx.arc(cx, y + h * 0.5, 2.2 * scale, 0, Math.PI * 2); ctx.fill();
  ctx.restore();
}

function drawDungeon3D() {
  const canvas = document.getElementById("dungeonCanvas");
  const mini = document.getElementById("dungeonMinimap");
  if (!canvas || !mini) return;

  const { def, st } = getDungeonCtx();
  const rect = canvas.getBoundingClientRect();
  const w = Math.max(280, Math.floor(rect.width || 500));
  const h = 270;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  canvas.width = w * dpr; canvas.height = h * dpr;
  const ctx = canvas.getContext("2d");
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  const horizonY = Math.floor(h * 0.45);
  const ceilGrad = ctx.createLinearGradient(0, 0, 0, horizonY);
  ceilGrad.addColorStop(0, def.ceilColor); ceilGrad.addColorStop(1, "#131c36");
  ctx.fillStyle = ceilGrad; ctx.fillRect(0, 0, w, horizonY);

  const floorGrad = ctx.createLinearGradient(0, horizonY, 0, h);
  floorGrad.addColorStop(0, "#0b1020"); floorGrad.addColorStop(1, def.floorColor);
  ctx.fillStyle = floorGrad; ctx.fillRect(0, horizonY, w, h - horizonY);

  ctx.strokeStyle = "rgba(255,255,255,0.08)"; ctx.lineWidth = 1;
  for (let i = -4; i <= 4; i++) {
    ctx.beginPath(); ctx.moveTo(w / 2 + i * 22, horizonY); ctx.lineTo(w / 2 + i * 95, h); ctx.stroke();
  }

  const vec = DIR_VECTORS[st.dir];
  const rightVec = DIR_VECTORS[(st.dir + 1) % 4];
  const depths = [3, 2, 1];
  const depthRects = {
    3: { top: horizonY - 26, bot: horizonY + 24, wRatio: 0.24 },
    2: { top: horizonY - 48, bot: horizonY + 46, wRatio: 0.44 },
    1: { top: horizonY - 82, bot: horizonY + 80, wRatio: 0.74 }
  };

  const isWallAt = (gx, gy) =>
    gy < 0 || gy >= def.grid.length || gx < 0 || gx >= def.grid[0].length || def.grid[gy][gx] === 1;

  const getWallDoorAt = (gx, gy) =>
    def.wallDoors ? (def.wallDoors[`${gx},${gy}`] || null) : null;

  const paintWallTexture = (x0, y0, ww, hh, style, shade, doorObj, seed) => {
    if (doorObj) {
      const isSub = doorObj.kind === "sub_dungeon";
      drawWallDoor(ctx, x0, y0, ww, hh, def, shade, isSub ? "NEXT 3D" : "WALL DOOR", doorObj.name.slice(0, 8), isSub ? "#38bdf8" : "#fbbf24");
      return;
    }
    const sd = seed || 1;
    const rnd = makeSeededRand(sd * 1013 + 17);
    ctx.save(); ctx.globalAlpha = shade; ctx.fillStyle = def.wallColor; ctx.fillRect(x0, y0, ww, hh);
    ctx.beginPath(); ctx.rect(x0, y0, ww, hh); ctx.clip();
    if (style === "neon_brick") {
      ctx.strokeStyle = "rgba(255,255,255,0.16)"; ctx.lineWidth = 1;
      const rows = 5;
      for (let i = 1; i < rows; i++) { const yy = y0 + (hh * i) / rows; ctx.beginPath(); ctx.moveTo(x0, yy); ctx.lineTo(x0 + ww, yy); ctx.stroke(); }
      for (let i = 0; i < rows; i++) {
        const yy = y0 + (hh * i) / rows; const off = i % 2 ? ww / 8 : 0;
        for (let xx = x0 + off + ww / 4; xx < x0 + ww; xx += ww / 4) { ctx.beginPath(); ctx.moveTo(xx, yy); ctx.lineTo(xx, yy + hh / rows); ctx.stroke(); }
      }
      const signW = ww * (0.30 + rnd() * 0.22), signH = hh * 0.20;
      const sx = x0 + ww * (0.06 + rnd() * 0.45), sy = y0 + hh * (0.10 + rnd() * 0.12);
      const neon = rnd() > 0.5 ? "#f472b6" : def.wallAccent;
      ctx.save(); ctx.shadowColor = neon; ctx.shadowBlur = 12;
      ctx.strokeStyle = neon; ctx.lineWidth = 2.5; ctx.strokeRect(sx, sy, signW, signH);
      ctx.beginPath(); ctx.moveTo(sx + signW * 0.15, sy + signH * 0.55); ctx.lineTo(sx + signW * 0.85, sy + signH * 0.55); ctx.stroke();
      ctx.restore();
      const pw = ww * 0.20, ph = hh * 0.34, px = x0 + ww * (0.62 + rnd() * 0.14), py = y0 + hh * 0.48;
      ctx.fillStyle = "rgba(241,245,249,0.85)"; ctx.fillRect(px, py, pw, ph);
      ctx.fillStyle = "rgba(190,24,93,0.85)"; ctx.fillRect(px, py, pw, ph * 0.3);
      ctx.fillStyle = "rgba(15,23,42,0.7)"; ctx.fillRect(px + pw * 0.12, py + ph * 0.45, pw * 0.76, 2); ctx.fillRect(px + pw * 0.12, py + ph * 0.62, pw * 0.6, 2);
    } else if (style === "concrete_rust") {
      ctx.strokeStyle = "rgba(0,0,0,0.35)"; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(x0 + ww * 0.5, y0); ctx.lineTo(x0 + ww * 0.5, y0 + hh); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x0, y0 + hh * 0.52); ctx.lineTo(x0 + ww, y0 + hh * 0.52); ctx.stroke();
      ctx.strokeStyle = "rgba(0,0,0,0.45)"; ctx.lineWidth = 1;
      for (let c = 0; c < 2; c++) {
        let cxp = x0 + ww * (0.15 + rnd() * 0.7), cyp = y0;
        ctx.beginPath(); ctx.moveTo(cxp, cyp);
        const segs = 4 + Math.floor(rnd() * 3);
        for (let i2 = 0; i2 < segs; i2++) { cxp += (rnd() - 0.5) * ww * 0.09; cyp += hh / segs; ctx.lineTo(cxp, cyp); }
        ctx.stroke();
      }
      for (let i2 = 0; i2 < 3; i2++) {
        ctx.fillStyle = "rgba(180,83,9,0.22)";
        ctx.beginPath(); ctx.ellipse(x0 + ww * rnd(), y0 + hh * (0.72 + rnd() * 0.24), ww * (0.05 + rnd() * 0.08), hh * 0.06, 0, 0, Math.PI * 2); ctx.fill();
      }
      ctx.strokeStyle = def.wallAccent; ctx.globalAlpha = shade * 0.55; ctx.lineWidth = 3;
      const gx = x0 + ww * (0.1 + rnd() * 0.4), gy = y0 + hh * (0.58 + rnd() * 0.2);
      ctx.beginPath(); ctx.arc(gx + ww * 0.1, gy, ww * 0.09, Math.PI * 0.15, Math.PI * 1.15); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(gx, gy + hh * 0.1); ctx.lineTo(gx + ww * 0.22, gy + hh * 0.02); ctx.stroke();
      ctx.globalAlpha = shade;
    } else if (style === "under_pipe") {
      for (let i = 0; i < 3; i++) {
        const py = y0 + hh * (0.07 + i * 0.10), ph = Math.max(3, hh * 0.05);
        ctx.fillStyle = i === 1 ? "#475569" : "#334155"; ctx.fillRect(x0, py, ww, ph);
        ctx.fillStyle = "rgba(255,255,255,0.28)"; ctx.fillRect(x0, py, ww, 1.5);
        ctx.fillStyle = "rgba(0,0,0,0.4)";
        const jx = x0 + ww * (0.2 + ((sd * (i + 3)) % 55) / 100);
        ctx.fillRect(jx, py - 1, 4, ph + 2);
      }
      const vx = x0 + ww * (0.25 + rnd() * 0.5), vy = y0 + hh * 0.42, vr = Math.max(4, ww * 0.05);
      ctx.strokeStyle = "#f87171"; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.arc(vx, vy, vr, 0, Math.PI * 2); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(vx - vr, vy); ctx.lineTo(vx + vr, vy); ctx.moveTo(vx, vy - vr); ctx.lineTo(vx, vy + vr); ctx.stroke();
      ctx.fillStyle = "rgba(2,6,4,0.35)";
      for (let i2 = 0; i2 < 3; i2++) { const sx2 = x0 + ww * rnd(); ctx.fillRect(sx2, y0 + hh * 0.3, 3, hh * (0.3 + rnd() * 0.3)); }
      const bandH = hh * 0.10, by = y0 + hh - bandH;
      ctx.save(); ctx.beginPath(); ctx.rect(x0, by, ww, bandH); ctx.clip();
      for (let xx = x0 - bandH; xx < x0 + ww + bandH; xx += 12) {
        ctx.fillStyle = "rgba(250,204,21,0.75)";
        ctx.beginPath(); ctx.moveTo(xx, by + bandH); ctx.lineTo(xx + 6, by); ctx.lineTo(xx + 12, by); ctx.lineTo(xx + 6, by + bandH); ctx.closePath(); ctx.fill();
      }
      ctx.restore();
    }
    ctx.strokeStyle = def.wallAccent; ctx.lineWidth = 2; ctx.strokeRect(x0, y0, ww, hh);
    ctx.restore();
  };

  for (const d of depths) {
    const cx = st.x + vec.dx * d; const cy = st.y + vec.dy * d;
    const box = depthRects[d]; const centerW = w * box.wRatio;
    const leftX = (w - centerW) / 2; const wallH = box.bot - box.top;
    const shade = d === 3 ? 0.48 : d === 2 ? 0.74 : 0.96;

    const lx = cx - rightVec.dx; const ly = cy - rightVec.dy;
    const rx = cx + rightVec.dx; const ry = cy + rightVec.dy;

    if (isWallAt(lx, ly)) {
      ctx.save(); ctx.globalAlpha = shade * 0.72; ctx.fillStyle = def.wallColor;
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(leftX, box.top); ctx.lineTo(leftX, box.bot); ctx.lineTo(0, h); ctx.closePath(); ctx.fill();
      ctx.strokeStyle = def.wallAccent; ctx.lineWidth = 1.5; ctx.stroke(); ctx.restore();
    }
    if (isWallAt(rx, ry)) {
      ctx.save(); ctx.globalAlpha = shade * 0.72; ctx.fillStyle = def.wallColor;
      ctx.beginPath(); ctx.moveTo(w, 0); ctx.lineTo(leftX + centerW, box.top); ctx.lineTo(leftX + centerW, box.bot); ctx.lineTo(w, h); ctx.closePath(); ctx.fill();
      ctx.strokeStyle = def.wallAccent; ctx.lineWidth = 1.5; ctx.stroke(); ctx.restore();
    }
    if (isWallAt(cx, cy)) {
      paintWallTexture(leftX, box.top, centerW, wallH, def.wallStyle, shade, getWallDoorAt(cx, cy), cx * 31 + cy * 57 + 7);
    } else if (cy >= 0 && cy < def.grid.length && cx >= 0 && cx < def.grid[0].length) {
      const cellVal = def.grid[cy][cx]; const k = `${cx},${cy}`;
      ctx.save(); ctx.globalAlpha = shade;
      if (cellVal === 9) {
        ctx.fillStyle = "rgba(74, 222, 128, 0.28)";
        ctx.fillRect(leftX + centerW * 0.2, box.bot - wallH * 0.26, centerW * 0.6, wallH * 0.24);
        ctx.strokeStyle = "#4ade80"; ctx.lineWidth = 2.5;
        ctx.strokeRect(leftX + centerW * 0.2, box.bot - wallH * 0.26, centerW * 0.6, wallH * 0.24);
        ctx.fillStyle = "#86efac"; ctx.font = "bold 11px sans-serif"; ctx.textAlign = "center";
        ctx.fillText("入口ドア", w / 2, box.bot - wallH * 0.1);
      } else if (cellVal === 8 && def.parentLabel) {
        ctx.fillStyle = "rgba(56, 189, 248, 0.28)";
        ctx.fillRect(leftX + centerW * 0.2, box.bot - wallH * 0.26, centerW * 0.6, wallH * 0.24);
        ctx.strokeStyle = "#38bdf8"; ctx.lineWidth = 2.5;
        ctx.strokeRect(leftX + centerW * 0.2, box.bot - wallH * 0.26, centerW * 0.6, wallH * 0.24);
        ctx.fillStyle = "#bae6fd"; ctx.font = "bold 10px sans-serif"; ctx.textAlign = "center";
        ctx.fillText(`${def.parentLabel}へ`, w / 2, box.bot - wallH * 0.1);
      } else if (cellVal === 3 && def.npcs[k]) {
        const npc = def.npcs[k]; const scale = d === 3 ? 0.55 : d === 2 ? 0.8 : 1.05; const baseY = box.bot - 8;
        drawNpcGraphic(ctx, npc, w / 2, baseY, scale);
        ctx.fillStyle = "#dbeafe"; ctx.font = `bold ${Math.max(10, Math.floor(12 * shade + 2))}px sans-serif`; ctx.textAlign = "center";
        ctx.fillText(npc.name.split(" ").pop(), w / 2, baseY - 68 * scale);
      } else if (st.chests && st.chests[`${cx},${cy}`]) {
        drawChestGraphic(ctx, w / 2, box.bot - 8, d === 3 ? 0.55 : d === 2 ? 0.8 : 1.05);
        ctx.fillStyle = "#fde68a"; ctx.font = `bold ${Math.max(10, Math.floor(12 * shade + 2))}px sans-serif`; ctx.textAlign = "center";
        ctx.fillText("宝箱", w / 2, box.bot - 46 * (d === 3 ? 0.55 : d === 2 ? 0.8 : 1.05));
      }
      ctx.restore();
    }
  }

  if (state.activeEnemy) {
    const en = state.activeEnemy;
    ctx.save(); ctx.fillStyle = "rgba(127, 29, 29, 0.35)"; ctx.fillRect(0, 0, w, h);
    drawEnemyGraphic(ctx, en.kind, w / 2, horizonY + 55, 1.8);
    ctx.fillStyle = "#ffffff"; ctx.font = "900 15px sans-serif"; ctx.textAlign = "center";
    ctx.fillText(`⚔ ${en.name} (HP:${en.hp}/${en.maxHp})`, w / 2, horizonY - 42);
    ctx.restore();
  }

  ctx.fillStyle = "rgba(248, 250, 252, 0.92)"; ctx.font = "bold 11px sans-serif"; ctx.textAlign = "left";
  ctx.fillText(`${def.name} (${st.x},${st.y}) ${DIR_VECTORS[st.dir].name}向き`, 10, 18);

  const rows = def.grid.length; const cols = def.grid[0].length; const tile = rows > 9 ? 8 : 10;
  mini.width = cols * tile; mini.height = rows * tile;
  const mctx = mini.getContext("2d"); mctx.clearRect(0, 0, mini.width, mini.height);

  for (let y = 0; y < rows; y++) {
    for (let x = 0; x < cols; x++) {
      const v = def.grid[y][x]; const k = `${x},${y}`;
      const isWallDoor = v === 1 && def.wallDoors && def.wallDoors[k];
      if (isWallDoor) mctx.fillStyle = def.wallDoors[k].kind === "sub_dungeon" ? "#38bdf8" : "#f59e0b";
      else if (v === 1) mctx.fillStyle = "#475569";
      else if (v === 9) mctx.fillStyle = "#4ade80";
      else if (v === 8) mctx.fillStyle = "#38bdf8";
      else if (st.chests && st.chests[k] && st.chestsRevealed) mctx.fillStyle = "#fbbf24";
      else if (st.visited.has(k)) mctx.fillStyle = v === 3 ? "#60a5fa" : "#1e293b";
      else mctx.fillStyle = "#080c16";
      mctx.fillRect(x * tile, y * tile, tile - 1, tile - 1);
    }
  }
  mctx.fillStyle = "#f43f5e"; mctx.beginPath();
  mctx.arc(st.x * tile + tile / 2, st.y * tile + tile / 2, Math.max(2.5, tile * 0.35), 0, Math.PI * 2); mctx.fill();
}

function renderDungeonQuestDetailCard() {
  const q = QUESTS.find(x => x.id === state.activeQuestId);
  if (!q) {
    return `<div class="quest-card"><div><strong>📜 現在の依頼：なし</strong></div><div class="sub" style="margin-top:3px;">酒場の「依頼」タブから受注できる。</div></div>`;
  }
  let statusLine = "";
  if (q.kind === "delivery") statusLine = `進捗：所持ハーブ ${totalHerbsAvailable()} / ${q.needQty}個`;
  else if (q.kind === "search") statusLine = `進捗：安否確認 ${state.questProgress.foundPerson ? "完了（ケンジに話しかけて報告へ）" : "未確認"}`;
  else if (q.kind === "collect") statusLine = `進捗：未払い金回収 ${state.questProgress.collectedGold ? "回収済み（繁華街のジンへ渡そう）" : "未回収（町外れのタロウから回収）"}`;
  return `
    <div class="quest-card">
      <div><strong>📜 受注中の依頼：${q.title}</strong></div>
      <div class="sub" style="color:#93c5fd; margin-top:2px;">目的地：${q.targetPerson}</div>
      <div class="sub" style="color:#e2e8f0; margin-top:2px;">内容：${q.desc}</div>
      <div class="sub" style="color:#fde68a; margin-top:3px;">${statusLine}（報酬: ¥${q.rewardGold.toLocaleString()} / +${q.rewardExp} EXP）</div>
    </div>
  `;
}

function renderDungeonPanel(panel) {
  const { spot, def, st, cell, key, npc, isGate, isSubReturn, frontDoor, frontKey } = getDungeonCtx();
  const dirInfo = DIR_VECTORS[st.dir];

  const interactBtnClass = frontDoor ? "small door-btn" : "small";
  const interactLabel = frontDoor
    ? (frontDoor.kind === "sub_dungeon" ? `🚪 突入：${frontDoor.name}` : `🚪 ドアを開ける：${frontDoor.name}`)
    : (isSubReturn ? `↩ ${def.parentLabel}へ戻る` : (isGate ? "入口ドアを調べる" : (cell === 3 && npc ? `話す：${npc.name}` : ((st.chests && st.chests[key]) ? "🎁 宝箱を開ける" : "周囲を調べる(+1T)"))));

  let enemyHtml = "";
  if (state.activeEnemy) {
    const en = state.activeEnemy;
    const usableButtonsHtml = USABLE_ITEM_KEYS.map(hk => {
      const hItem = ITEMS[hk];
      const cnt = state.bag[hk] || 0;
      return `
        <button class="small good" ${cnt <= 0 || state.hp >= state.maxHp ? "disabled" : ""} onclick="useUsableItem('${hk}', true)">
          ${hItem.name} (+${hItem.heal}HP／残${cnt})
        </button>
      `;
    }).join("");

    enemyHtml = `
      <div class="enemy-card">
        <div><strong>⚔ 戦闘中：【${en.name}】</strong> <span class="sub">HP ${en.hp}/${en.maxHp} ／ 攻撃力 ${en.atk} ／ EXP +${en.exp || 25}</span></div>
        <div class="sub" style="margin:4px 0;">自分：LV.${state.level} HP ${state.hp}/${state.maxHp} ／ ATK ${currentAttackPower()} ／ DEF ${currentDefensePower()} ／ 報酬 ¥${en.gold.toLocaleString()}</div>
        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px;">
          <button class="small danger" onclick="attackEnemy()">攻撃する(+1T)</button>
