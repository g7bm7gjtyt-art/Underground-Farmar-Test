  ctx.arc(dx + doorW * 0.82, dy + doorH * 0.54, Math.max(2.5, doorW * 0.07), 0, Math.PI * 2); ctx.fill();

  const plateH = Math.max(15, doorH * 0.24);
  ctx.fillStyle = "rgba(9, 13, 26, 0.92)"; ctx.fillRect(dx - 8, dy - plateH - 4, doorW + 16, plateH);
  ctx.strokeStyle = accentColor; ctx.lineWidth = 1.5; ctx.strokeRect(dx - 8, dy - plateH - 4, doorW + 16, plateH);

  ctx.fillStyle = "#f8fafc"; ctx.font = `bold ${Math.max(9, Math.floor(10 * shade + 2))}px sans-serif`;
  ctx.textAlign = "center"; ctx.fillText(labelTop, x0 + ww / 2, dy - plateH / 2 - 1);

  if (labelMain) {
