const bgm = {
  ctx: null,
  timer: null,
  enabled: true,
  mode: "none",
  step: 0,

  ensureCtx() {
    if (!this.ctx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (AC) this.ctx = new AC();
    }
    if (this.ctx && this.ctx.state === "suspended") {
      this.ctx.resume().catch(() => {});
    }
  },

  playSE(kind) {
    if (!this.enabled) return;
    this.ensureCtx();
    if (!this.ctx) return;
    const now = this.ctx.currentTime;

    const tone = (freq, endFreq, dur, type = "square", vol = 0.06, delay = 0) => {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, now + delay);
      if (endFreq !== null) {
        osc.frequency.exponentialRampToValueAtTime(Math.max(40, endFreq), now + delay + dur);
      }
      gain.gain.setValueAtTime(vol, now + delay);
      gain.gain.exponentialRampToValueAtTime(0.0008, now + delay + dur);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start(now + delay);
      osc.stop(now + delay + dur + 0.01);
    };

    switch (kind) {
      case "select": tone(660, 880, 0.06, "triangle", 0.055); break;
      case "confirm":
        tone(523.25, 523.25, 0.06, "square", 0.05, 0);
        tone(783.99, 1046.5, 0.09, "square", 0.055, 0.06);
        break;
      case "step": tone(190, 140, 0.045, "triangle", 0.04); break;
      case "door":
        tone(330, 440, 0.07, "triangle", 0.06, 0);
        tone(554.37, 659.25, 0.09, "triangle", 0.06, 0.07);
        break;
      case "attack": tone(420, 110, 0.11, "sawtooth", 0.085); break;
      case "skill":
        tone(392.0, 784.0, 0.09, "square", 0.07, 0);
        tone(784.0, 1174.66, 0.12, "triangle", 0.075, 0.08);
        break;
      case "damage": tone(175, 65, 0.16, "sawtooth", 0.095); break;
      case "heal":
        tone(440, 554.37, 0.08, "sine", 0.07, 0);
        tone(554.37, 659.25, 0.08, "sine", 0.07, 0.08);
        tone(659.25, 880, 0.12, "sine", 0.075, 0.16);
        break;
      case "win":
        tone(523.25, 523.25, 0.08, "square", 0.065, 0);
        tone(659.25, 659.25, 0.08, "square", 0.065, 0.09);
        tone(783.99, 783.99, 0.08, "square", 0.065, 0.18);
        tone(1046.5, 1046.5, 0.22, "square", 0.075, 0.27);
        break;
      case "loot":
        tone(587.33, 880, 0.09, "triangle", 0.065, 0);
        tone(880, 1174.66, 0.12, "triangle", 0.065, 0.08);
        break;
      case "error": tone(180, 130, 0.12, "sawtooth", 0.065); break;
      default: tone(600, 600, 0.05, "triangle", 0.04);
    }
  },

  setMode(newMode) {
    const prevMode = this.mode;
    this.mode = newMode;
    if (!this.enabled || newMode === "none") {
      this.stopLoop();
      return;
    }
    this.ensureCtx();
    if (this.timer && prevMode !== newMode) this.stopLoop();
    if (!this.timer) {
      this.step = 0;
      const intervalMs = newMode === "battle" ? 190 : (newMode === "bar" ? 310 : (newMode === "title" ? 300 : 260));
      this.timer = setInterval(() => this.tick(), intervalMs);
    }
  },

  toggle() {
    this.enabled = !this.enabled;
    if (!this.enabled) {
      this.stopLoop();
    } else {
      this.playSE("confirm");
      if (this.mode !== "none") this.setMode(this.mode);
    }
    return this.enabled;
  },

  stopLoop() {
    if (this.timer) {
      clearInterval(this.timer);
      this.timer = null;
    }
  },

  tick() {
    if (!this.enabled || !this.ctx || this.mode === "none") return;
    if (state.tab === "bar" && state.barSub === "game") return;
    const now = this.ctx.currentTime;
    const scales = {
      town:    [261.63, 293.66, 329.63, 392.00, 440.00, 392.00, 329.63, 293.66],
      bar:     [196.00, 246.94, 293.66, 329.63, 293.66, 246.94, 220.00, 246.94],
      dungeon: [146.83, 155.56, 174.61, 196.00, 174.61, 155.56, 130.81, 146.83],
      battle:  [220.00, 261.63, 311.13, 293.66, 261.63, 220.00, 196.00],
      title:   [440.00, 523.25, 659.25, 523.25, 349.23, 440.00, 523.25, 440.00, 329.63, 392.00, 523.25, 392.00, 587.33, 493.88, 392.00, 329.63]
    };
    const arr = scales[this.mode] || scales.town;
    const freq = arr[this.step % arr.length];
    this.step++;

    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = this.mode === "battle" ? "sawtooth" : "triangle";
    osc.frequency.setValueAtTime(freq, now);
    gain.gain.setValueAtTime(0.022, now);
    gain.gain.exponentialRampToValueAtTime(0.0008, now + 0.18);
    osc.connect(gain);
    gain.connect(this.ctx.destination);
    osc.start(now);
    osc.stop(now + 0.19);

    if (this.mode === "title") {
      const playedIdx = (this.step - 1) % arr.length;
      if (playedIdx % 4 === 0) {
        const bassFreq = [110.00, 87.31, 130.81, 98.00][Math.floor(playedIdx / 4) % 4];
        const bOsc = this.ctx.createOscillator();
        const bGain = this.ctx.createGain();
        bOsc.type = "triangle";
        bOsc.frequency.setValueAtTime(bassFreq, now);
        bGain.gain.setValueAtTime(0.035, now);
        bGain.gain.exponentialRampToValueAtTime(0.0008, now + 1.05);
        bOsc.connect(bGain);
        bGain.connect(this.ctx.destination);
        bOsc.start(now);
        bOsc.stop(now + 1.06);
      }
    }
  }
};

function syncCurrentBgmMode() {
  if (document.body.classList.contains("title-open")) {
    bgm.setMode("title");
    return;
  }
  if (state.tab === "bar" && state.barSub === "game") {
    bgm.setMode("none");
    return;
  }
  if (state.locationMode === "dungeon") {
    bgm.setMode(state.activeEnemy ? "battle" : "dungeon");
  } else if (state.tab === "bar") {
    bgm.setMode("bar");
  } else {
    bgm.setMode("town");
  }
}

