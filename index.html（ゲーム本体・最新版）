        </div>
        <div class="battle-heal-box">
          <div class="sub" style="color:#fde68a; margin-bottom:4px;"><strong>回復アイテムを使う</strong></div>
          <div style="display:flex; gap:5px; flex-wrap:wrap;">${usableButtonsHtml}</div>
        </div>
      </div>
    `;
  }

  const questBoxHtml = state.showQuestModalInDungeon ? renderDungeonQuestDetailCard() : "";

  let detailHtml = "";
  if (!state.activeEnemy && state.activeInteract) {
    if (state.activeInteract.type === "gate" && isGate && state.activeInteract.key === key) {
      detailHtml = `
        <div class="facility-card" style="border-color:#4ade80;">
          <div><strong>【${def.name}・入口ドア】</strong></div>
          <div class="sub" style="margin:4px 0 8px;">緑色の入口ドアの上に立っている。ここから街へ戻れる。</div>
          <button class="small good" onclick="returnHomeFromGate()">🚪 入口ドアから自宅へ帰る(+2T)</button>
        </div>
      `;
    } else if (state.activeInteract.type === "door" && frontDoor && state.activeInteract.key === frontKey) {
      detailHtml = renderFacilityDetail(frontDoor, spot);
    } else if (state.activeInteract.type === "npc" && npc && state.activeInteract.key === key) {
      detailHtml = renderNpcDetail(npc, spot);
    }
  }

  const quickHealHtml = `
    <div class="facility-card" style="border-color:#34d399; padding:7px 9px;">
      <div class="sub" style="color:#a7f3d0; margin-bottom:4px;"><strong>アイテム使用</strong>（HP ${state.hp}/${state.maxHp}）</div>
      <div style="display:flex; gap:5px; flex-wrap:wrap;">
        ${USABLE_ITEM_KEYS.map(hk => `<button class="small good" ${(state.bag[hk] || 0) <= 0 || state.hp >= state.maxHp ? "disabled" : ""} onclick="useUsableItem('${hk}', ${Boolean(state.activeEnemy)})">${ITEMS[hk].name} (+${ITEMS[hk].heal}／残${state.bag[hk] || 0})</button>`).join("")}
      </div>
