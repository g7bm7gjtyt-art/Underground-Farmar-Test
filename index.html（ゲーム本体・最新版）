    ? `<button class="small" onclick="returnToParentDungeon()">↩ ${def.parentLabel}へ戻る(+1T)</button>`
    : (isGate
      ? `<button class="small good" onclick="returnHomeFromGate()">🚪 入口ドアから帰る(+2T)</button>`
      : `<button class="small" disabled>帰還不可(入口ドアへ)</button>`);

  panel.innerHTML = `
    <div class="section-title" style="display:flex; justify-content:space-between; align-items:center; gap:6px; flex-wrap:wrap;">
      <span>3Dダンジョン：${def.name} <span class="sub">（${def.subtitle}）</span></span>
      <button class="small ${state.showQuestModalInDungeon ? "active" : ""}" onclick="toggleDungeonQuestBox()">📜 依頼確認</button>
    </div>
    ${questBoxHtml}
    <div class="dungeon-stage">
      <canvas id="dungeonCanvas" class="dungeon-canvas"></canvas>
      <div class="minimap-box"><canvas id="dungeonMinimap"></canvas></div>
      <div class="dungeon-hud-bar">
        <span>座標: <strong>(${st.x}, ${st.y})</strong> / 向き: <strong>${dirInfo.arrow} ${dirInfo.name}</strong></span>
        <span class="sub">緑=入口 / 青=続き・戻り / 金=ドア</span>
      </div>
    </div>
    ${enemyHtml}
    <div class="dpad-grid">
      <button class="small" onclick="turnDungeon(-1)">↺ 左回転</button>
      <button class="small" onclick="moveDungeon(1)">▲ 前進(+1T)</button>
      <button class="small" onclick="turnDungeon(1)">↻ 右回転</button>
      <button class="small" onclick="moveDungeon(-1)">▼ 後退(+1T)</button>
      <button class="${interactBtnClass}" onclick="interactDungeonHere()">${interactLabel}</button>
      ${returnSlotHtml}
