    <script>
    /**
     * BONG-KUN'S TRIP SHOOTER
     * 擬人化ボング「ボングくん」のサイケデリック縦スクロールシューティング
     */

    const HIGHSCORE_STORAGE_KEY = 'bongkun_adventure_highscores_v1';

    // 保存先（localStorage）が使えない環境でも、その回のプレイ中は記録が残るようにする
    const hsStore = (() => {
        let mem = null;
        return {
            get() { try { return localStorage.getItem(HIGHSCORE_STORAGE_KEY); } catch (_) { return mem; } },
            set(v) { mem = v; try { localStorage.setItem(HIGHSCORE_STORAGE_KEY, v); } catch (_) {} },
            clear() { mem = null; try { localStorage.removeItem(HIGHSCORE_STORAGE_KEY); } catch (_) {} }
        };
    })();

    function loadHighScores() {
        try {
            const raw = hsStore.get();
            if (!raw) return [];
            const arr = JSON.parse(raw);
            if (!Array.isArray(arr)) return [];
            return arr
                .filter(entry => entry && typeof entry.score === 'number' && Number.isFinite(entry.score))
                .map(entry => ({
                    score: Math.max(0, Math.floor(entry.score)),
                    stage: Math.max(1, Math.floor(Number.isFinite(entry.stage) ? entry.stage : 1)),
                    date: typeof entry.date === 'string' && entry.date ? entry.date : '----/--/-- --:--'
                }))
                .sort((a, b) => b.score - a.score)
                .slice(0, 10);
        } catch (_) {
            return [];
        }
    }

    function recordHighScore(score, stage) {
        try {
            const s = Math.max(0, Math.floor(Number.isFinite(score) ? score : 0));
            if (s <= 0) return loadHighScores();
            const st = Math.max(1, Math.floor(Number.isFinite(stage) ? stage : 1));
            const now = new Date();
            const pad = n => String(n).padStart(2, '0');
            const formattedDate = `${now.getFullYear()}/${pad(now.getMonth() + 1)}/${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}`;

            const list = loadHighScores();
            list.push({ score: s, stage: st, date: formattedDate });
            list.sort((a, b) => b.score - a.score);
            const top10 = list.slice(0, 10);
            hsStore.set(JSON.stringify(top10));
            return top10;
        } catch (_) {
            return loadHighScores();
        }
    }

    function clearHighScores() {
        hsStore.clear();
    }

    // ==========================================
    // 1. サウンドエンジン (Web Audio API + Munchies!ボイス)
    // ==========================================
    class SoundEngine {
        constructor() {
            this.ctx = null;
            this.muted = false;
            this.bgmPlaying = false;
            this.bgmMode = 'normal'; // 'normal' or 'boss'
            this.bgmVariation = 0;  // 通常BGMバリエーション (0〜2)
            this.bossVariation = 0; // ボスBGMバリエーション (0〜1)
            this.bgmStep = 0;
            this.bgmTimer = null;
            this.nextNoteTime = 0;
        }

        init() {
            if (!this.ctx) {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                this.ctx = new AudioCtx();
            }
            if (this.ctx.state === 'suspended') {
                this.ctx.resume();
            }
        }

        toggleMute() {
            this.muted = !this.muted;
            if (this.muted) {
                this.stopBGM(false); // 状態は保持しつつ発音停止
            } else if (this.bgmPlaying) {
                this.startBGM(this.bgmMode, this.bgmVariation, this.bossVariation);
            }
            return this.muted;
        }

        // チップチューン風サイケデリックBGM開始（複数バリエーション対応）
        startBGM(mode = 'normal', normalVar = null, bossVar = null) {
            this.bgmMode = mode;
            if (normalVar !== null) this.bgmVariation = normalVar % 3;
            if (bossVar !== null) this.bossVariation = bossVar % 2;
            this.bgmPlaying = true;
            if (this.muted || !this.ctx) return;

            if (this.bgmTimer) {
                clearInterval(this.bgmTimer);
                this.bgmTimer = null;
            }

            this.bgmStep = 0;
            this.nextNoteTime = this.ctx.currentTime + 0.05;

            this.bgmTimer = setInterval(() => {
                if (!this.bgmPlaying || this.muted || !this.ctx) return;
                let stepDuration = 0.135;
                if (this.bgmMode === 'boss') {
                    stepDuration = this.bossVariation === 0 ? 0.115 : 0.105;
                } else {
                    const durations = [0.135, 0.125, 0.145];
                    stepDuration = durations[this.bgmVariation % durations.length];
                }
                while (this.nextNoteTime < this.ctx.currentTime + 0.12) {
                    this.scheduleBgmStep(this.bgmStep, this.nextNoteTime, stepDuration);
                    this.nextNoteTime += stepDuration;
                    this.bgmStep = (this.bgmStep + 1) % 32;
                }
            }, 35);
        }

        setBgmMode(mode, normalVar = null, bossVar = null) {
            const varChanged =
                (mode === 'normal' && normalVar !== null && normalVar !== this.bgmVariation) ||
                (mode === 'boss' && bossVar !== null && bossVar !== this.bgmVariation);
            if (this.bgmMode === mode && !varChanged) return;
            this.startBGM(mode, normalVar, bossVar);
        }

        stopBGM(resetFlag = true) {
            if (resetFlag) this.bgmPlaying = false;
            if (this.bgmTimer) {
                clearInterval(this.bgmTimer);
                this.bgmTimer = null;
            }
        }

        scheduleBgmStep(step, time, dur) {
            if (!this.ctx || this.muted) return;

            if (this.bgmMode === 'normal') {
                if (this.bgmVariation === 0) {
                    // バリエーション0：ミクソリディアン／ヒッピーサイケな浮遊アルペジオ＆グルーヴベース
                    const bassNotes = [
                        110.00, 0, 110.00, 130.81, 146.83, 0, 146.83, 164.81,
                        196.00, 0, 196.00, 164.81, 146.83, 0, 130.81, 98.00,
                        110.00, 0, 110.00, 130.81, 146.83, 0, 164.81, 196.00,
                        220.00, 0, 196.00, 164.81, 146.83, 130.81, 110.00, 98.00
                    ];
                    const leadNotes = [
                        440.00, 554.37, 659.25, 783.99, 659.25, 554.37, 440.00, 392.00,
                        587.33, 739.99, 880.00, 739.99, 659.25, 587.33, 493.88, 392.00,
                        440.00, 659.25, 880.00, 987.77, 880.00, 783.99, 659.25, 554.37,
                        587.33, 659.25, 783.99, 880.00, 783.99, 659.25, 554.37, 440.00
                    ];

                    const bFreq = bassNotes[step];
                    if (bFreq > 0) this.playChipNote(bFreq, time, dur * 0.9, 'triangle', 0.065);

                    const lFreq = leadNotes[step];
                    if (lFreq > 0) {
                        const bend = Math.sin(step * 0.8) * 8;
                        this.playChipNote(lFreq + bend, time, dur * 0.75, 'square', 0.025, lFreq - bend);
                    }

                    if (step % 4 === 0) this.playChipKick(time, 0.07);
                    if (step % 4 === 2) this.playChipHat(time, 0.022);
                    else if (step % 2 === 1) this.playChipHat(time, 0.01);
                } else if (this.bgmVariation === 1) {
                    // バリエーション1：ラスタ・ダブ風オフビート＆ディープベース
                    const dubBass = [
                        82.41, 0, 0, 82.41, 0, 0, 98.00, 0,
                        110.00, 0, 0, 110.00, 0, 123.47, 130.81, 0,
                        82.41, 0, 0, 82.41, 0, 0, 146.83, 0,
                        130.81, 0, 123.47, 0, 110.00, 0, 98.00, 0
                    ];
                    const skankChord = [
                        0, 329.63, 0, 329.63, 0, 392.00, 0, 392.00,
                        0, 440.00, 0, 440.00, 0, 493.88, 0, 523.25,
                        0, 329.63, 0, 329.63, 0, 587.33, 0, 587.33,
                        0, 523.25, 0, 493.88, 0, 440.00, 0, 392.00
                    ];

                    const bFreq = dubBass[step];
                    if (bFreq > 0) this.playChipNote(bFreq, time, dur * 1.4, 'sine', 0.09, bFreq * 0.88);

                    const sFreq = skankChord[step];
                    if (sFreq > 0) this.playChipNote(sFreq, time, dur * 0.55, 'triangle', 0.035);

                    if (step % 8 === 0 || step % 8 === 4) this.playChipKick(time, 0.075);
                    if (step % 4 === 2) this.playChipHat(time, 0.026);
                } else {
                    // バリエーション2：コズミック・スペースシンセ＆軽快アルペジオ
                    const spaceBass = [
                        130.81, 130.81, 0, 130.81, 164.81, 164.81, 0, 164.81,
                        174.61, 174.61, 0, 174.61, 196.00, 196.00, 0, 196.00,
                        130.81, 130.81, 0, 146.83, 164.81, 164.81, 0, 196.00,
                        220.00, 0, 196.00, 0, 174.61, 0, 164.81, 0
                    ];
                    const spaceLead = [
                        523.25, 659.25, 783.99, 1046.50, 783.99, 659.25, 523.25, 659.25,
                        587.33, 698.46, 880.00, 1174.66, 880.00, 698.46, 587.33, 698.46,
                        523.25, 783.99, 1046.50, 1318.51, 1046.50, 783.99, 659.25, 783.99,
                        880.00, 783.99, 698.46, 659.25, 587.33, 523.25, 493.88, 523.25
                    ];

                    const bFreq = spaceBass[step];
                    if (bFreq > 0) this.playChipNote(bFreq, time, dur * 0.85, 'triangle', 0.06);

                    const lFreq = spaceLead[step];
                    if (lFreq > 0) this.playChipNote(lFreq, time, dur * 0.7, 'sine', 0.036, lFreq * 1.02);

                    if (step % 4 === 0) this.playChipKick(time, 0.065);
                    if (step % 2 === 1) this.playChipHat(time, 0.015);
                }
            } else {
                if (this.bossVariation === 0) {
                    // ボスBGMバリエーション0：サイケデリック・アシッドチップチューン
                    const bossBass = [
                        110.00, 110.00, 220.00, 110.00, 116.54, 116.54, 233.08, 116.54,
                        130.81, 130.81, 261.63, 130.81, 146.83, 138.59, 130.81, 116.54,
                        110.00, 110.00, 220.00, 110.00, 146.83, 146.83, 293.66, 146.83,
                        164.81, 155.56, 146.83, 138.59, 130.81, 123.47, 116.54, 110.00
                    ];
                    const bossLead = [
                        880.00, 0, 932.33, 880.00, 783.99, 0, 880.00, 932.33,
                        1046.50, 932.33, 880.00, 783.99, 698.46, 783.99, 880.00, 0,
                        880.00, 1046.50, 1174.66, 1046.50, 932.33, 880.00, 783.99, 698.46,
                        659.25, 698.46, 783.99, 880.00, 932.33, 1046.50, 1174.66, 1318.51
                    ];

                    const bFreq = bossBass[step];
                    if (bFreq > 0) this.playChipNote(bFreq, time, dur * 0.8, 'sawtooth', 0.048);

                    const lFreq = bossLead[step];
                    if (lFreq > 0) this.playChipNote(lFreq, time, dur * 0.85, 'square', 0.032, lFreq * 1.03);

                    if (step % 2 === 0) this.playChipKick(time, 0.08);
                    if (step % 4 === 2) this.playChipHat(time, 0.03);
                } else {
                    // ボスBGMバリエーション1：ハイスピード・ブレイクコア／サイケブレイク
                    const breakBass = [
                        123.47, 0, 123.47, 246.94, 0, 185.00, 164.81, 0,
                        146.83, 0, 146.83, 293.66, 0, 220.00, 196.00, 0,
                        123.47, 246.94, 123.47, 0, 164.81, 0, 185.00, 220.00,
                        246.94, 220.00, 196.00, 185.00, 164.81, 146.83, 130.81, 123.47
                    ];
                    const breakLead = [
                        987.77, 1174.66, 0, 987.77, 880.00, 739.99, 987.77, 0,
                        1174.66, 1318.51, 1174.66, 0, 987.77, 880.00, 739.99, 880.00,
                        987.77, 0, 1318.51, 1479.98, 1318.51, 1174.66, 987.77, 880.00,
                        739.99, 880.00, 987.77, 1174.66, 1318.51, 1174.66, 987.77, 0
                    ];

                    const bFreq = breakBass[step];
                    if (bFreq > 0) this.playChipNote(bFreq, time, dur * 0.75, 'sawtooth', 0.045);

                    const lFreq = breakLead[step];
                    if (lFreq > 0) this.playChipNote(lFreq, time, dur * 0.7, 'triangle', 0.04, lFreq * 0.97);

                    if (step % 4 === 0 || step === 6 || step === 14 || step === 22) {
                        this.playChipKick(time, 0.085);
                    }
                    if (step % 2 === 1) this.playChipHat(time, 0.025);
                }
            }
        }

        playChipNote(freq, time, duration, type, volume, endFreq = null) {
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, time);
            if (endFreq) {
                osc.frequency.linearRampToValueAtTime(endFreq, time + duration);
            }

            gain.gain.setValueAtTime(volume, time);
            gain.gain.exponentialRampToValueAtTime(0.0008, time + duration);

            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(time);
            osc.stop(time + duration);
        }

        playChipKick(time, volume) {
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(140, time);
            osc.frequency.exponentialRampToValueAtTime(38, time + 0.09);

            gain.gain.setValueAtTime(volume, time);
            gain.gain.exponentialRampToValueAtTime(0.001, time + 0.09);

            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(time);
            osc.stop(time + 0.09);
        }

        playChipHat(time, volume) {
            const bufferSize = Math.floor(this.ctx.sampleRate * 0.04);
            const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }
            const noise = this.ctx.createBufferSource();
            noise.buffer = buffer;

            const filter = this.ctx.createBiquadFilter();
            filter.type = 'highpass';
            filter.frequency.setValueAtTime(6500, time);

            const gain = this.ctx.createGain();
            gain.gain.setValueAtTime(volume, time);
            gain.gain.exponentialRampToValueAtTime(0.0008, time + 0.04);

            noise.connect(filter);
            filter.connect(gain);
            gain.connect(this.ctx.destination);
            noise.start(time);
        }

        // 煙発射音（シュポッという柔らかいノイズ＋サイン波）
        playShoot(isRainbow = false) {
            if (this.muted || !this.ctx) return;
            const now = this.ctx.currentTime;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = isRainbow ? 'triangle' : 'sine';
            const baseFreq = isRainbow ? 420 : 280;
            osc.frequency.setValueAtTime(baseFreq + Math.random() * 60, now);
            osc.frequency.exponentialRampToValueAtTime(90, now + 0.08);

            gain.gain.setValueAtTime(0.06, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);

            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + 0.08);
        }

        // 敵撃破音（ポップな爆発音）
        playExplosion(isBoss = false) {
            if (this.muted || !this.ctx) return;
            const now = this.ctx.currentTime;
            const duration = isBoss ? 0.8 : 0.22;

            const bufferSize = this.ctx.sampleRate * duration;
            const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }
            const noise = this.ctx.createBufferSource();
            noise.buffer = buffer;

            const filter = this.ctx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(isBoss ? 600 : 900, now);
            filter.frequency.exponentialRampToValueAtTime(60, now + duration);

            const gain = this.ctx.createGain();
            gain.gain.setValueAtTime(isBoss ? 0.35 : 0.15, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

            noise.connect(filter);
            filter.connect(gain);
            gain.connect(this.ctx.destination);
            noise.start(now);
        }

        // アイテム取得音（サイケデリックなアルペジオ）
        playPowerUp(isRare = false) {
            if (this.muted || !this.ctx) return;
            const now = this.ctx.currentTime;
            const notes = isRare ? [523.25, 659.25, 783.99, 1046.50, 1318.51] : [440, 554.37, 659.25, 880];
            notes.forEach((freq, idx) => {
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, now + idx * 0.055);
                gain.gain.setValueAtTime(0.12, now + idx * 0.055);
                gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.055 + 0.18);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now + idx * 0.055);
                osc.stop(now + idx * 0.055 + 0.18);
            });
        }

        // ピザ取得時「Munchies!」ボイス＆ファンファーレ
        playMunchiesVoice() {
            if (this.muted) return;
            if (this.ctx) {
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume().catch(() => {});
                }
                const now = this.ctx.currentTime;
                [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.05);
                    gain.gain.setValueAtTime(0.14, now + idx * 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.05 + 0.22);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now + idx * 0.05);
                    osc.stop(now + idx * 0.05 + 0.22);
                });
            }

            let spokenBySynth = false;
            try {
                if ('speechSynthesis' in window) {
                    const synth = window.speechSynthesis;
                    const utter = new SpeechSynthesisUtterance('Munchies');
                    utter.lang = 'en-US';
                    utter.rate = 1.02;
                    utter.pitch = 1.18;
                    utter.volume = 1.0;

                    const voices = synth.getVoices ? synth.getVoices() : [];
                    if (Array.isArray(voices) && voices.length > 0) {
                        const preferred =
                            voices.find(v => /en/i.test(v.lang) && /natural|google|samantha|alex|daniel|aria|jenny/i.test(v.name)) ||
                            voices.find(v => /en/i.test(v.lang)) ||
                            voices[0];
                        if (preferred) {
                            utter.voice = preferred;
                            utter.lang = preferred.lang || 'en-US';
                        }
                    }

                    utter.onstart = () => {
                        spokenBySynth = true;
                    };

                    try {
                        synth.resume();
                    } catch (_) {}
                    synth.cancel();
                    synth.speak(utter);

                    // ブラウザによっては初回発話が遅延・キャンセルされるため短いフォールバックを用意
                    setTimeout(() => {
                        if (!this.muted && !spokenBySynth && !synth.speaking) {
                            this.playSynthMunchiesFallback();
                        }
                    }, 220);
                    return;
                }
            } catch (_) {}

            this.playSynthMunchiesFallback();
        }

        // SpeechSynthesisが使えない／無音環境向けの「Munchies」シンセボイス
        playSynthMunchiesFallback() {
            if (this.muted || !this.ctx) return;
            try {
                const now = this.ctx.currentTime;
                // "Mun-"（低め〜上がる母音）と "-chies"（高めで弾む声）の2音節トーン＋子音ノイズ
                const syllables = [
                    { start: 0.02, dur: 0.14, f0: 210, f1: 275, form: 540, vol: 0.18 },
                    { start: 0.17, dur: 0.22, f0: 310, f1: 410, form: 920, vol: 0.20 }
                ];

                syllables.forEach(s => {
                    const osc = this.ctx.createOscillator();
                    const sub = this.ctx.createOscillator();
                    const formant = this.ctx.createBiquadFilter();
                    const gain = this.ctx.createGain();

                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(s.f0, now + s.start);
                    osc.frequency.exponentialRampToValueAtTime(s.f1, now + s.start + s.dur);

                    sub.type = 'triangle';
                    sub.frequency.setValueAtTime(s.f0 * 1.5, now + s.start);
                    sub.frequency.exponentialRampToValueAtTime(s.f1 * 1.5, now + s.start + s.dur);

                    formant.type = 'bandpass';
                    formant.frequency.setValueAtTime(s.form, now + s.start);
                    formant.Q.setValueAtTime(3.2, now + s.start);

                    gain.gain.setValueAtTime(0.001, now + s.start);
                    gain.gain.linearRampToValueAtTime(s.vol, now + s.start + 0.025);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + s.start + s.dur);

                    osc.connect(formant);
                    sub.connect(formant);
                    formant.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now + s.start);
                    sub.start(now + s.start);
                    osc.stop(now + s.start + s.dur + 0.02);
                    sub.stop(now + s.start + s.dur + 0.02);
                });

                // "-ch-" の子音アタック用ショートノイズ
                const nLen = Math.floor(this.ctx.sampleRate * 0.06);
                const nBuf = this.ctx.createBuffer(1, nLen, this.ctx.sampleRate);
                const chData = nBuf.getChannelData(0);
                for (let i = 0; i < nLen; i++) {
                    chData[i] = (Math.random() * 2 - 1) * (1 - i / nLen);
                }
                const nSrc = this.ctx.createBufferSource();
                nSrc.buffer = nBuf;
                const hp = this.ctx.createBiquadFilter();
                hp.type = 'bandpass';
                hp.frequency.setValueAtTime(2600, now + 0.14);
                hp.Q.setValueAtTime(1.5, now + 0.14);
                const nGain = this.ctx.createGain();
                nGain.gain.setValueAtTime(0.14, now + 0.14);
                nGain.gain.exponentialRampToValueAtTime(0.001, now + 0.20);
                nSrc.connect(hp);
                hp.connect(nGain);
                nGain.connect(this.ctx.destination);
                nSrc.start(now + 0.14);
            } catch (_) {}
        }

        // ダメージ音
        playHit() {
            if (this.muted || !this.ctx) return;
            const now = this.ctx.currentTime;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(160, now);
            osc.frequency.linearRampToValueAtTime(55, now + 0.25);
            gain.gain.setValueAtTime(0.22, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + 0.25);
        }

        // ボス警告サイレン音
        playBossWarning() {
            if (this.muted || !this.ctx) return;
            const now = this.ctx.currentTime;
            for (let i = 0; i < 3; i++) {
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                const start = now + i * 0.35;
                osc.frequency.setValueAtTime(320, start);
                osc.frequency.linearRampToValueAtTime(640, start + 0.17);
                osc.frequency.linearRampToValueAtTime(320, start + 0.34);
                gain.gain.setValueAtTime(0.12, start);
                gain.gain.exponentialRampToValueAtTime(0.001, start + 0.34);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(start);
                osc.stop(start + 0.34);
            }
        }
    }

