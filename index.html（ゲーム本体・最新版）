const REFINE_TURNS = 10;
const REFINE_OUT_QTY = 3;
function refineUnitPrice() { return 20000 + state.refiners.length * 5000; }
function buyRefineUnit() {
  if (state.plots.length < 8) { bgm.playSE("error"); log("精製ユニットはプラント区画が8つ揃ってから追加できる。"); return; }
  if (state.refiners.length >= 8) { bgm.playSE("error"); log("精製ユニットは8台までだ。"); return; }
  const price = refineUnitPrice();
  if (state.gold < price) { bgm.playSE("error"); log("資金不足だ。"); return; }
  state.gold -= price;
  state.refiners.push(null);
  bgm.playSE("confirm");
  log(`サプリ精製ユニットを増設した（${state.refiners.length}台目／¥${price.toLocaleString()}）。自宅プラントから使える。`);
  render();
}
function syncRefinerStates() {
  if (!Array.isArray(state.refiners)) return;
  for (const r of state.refiners) {
    if (r && r.status === "processing" && state.turn - r.plantedTurn >= (r.growRequired || REFINE_TURNS)) r.status = "ready";
  }
}
function startRefine(i) {
  syncRefinerStates();
  if (!Array.isArray(state.refiners) || state.refiners[i]) { bgm.playSE("error"); return; }
  if ((state.bag.supp_base || 0) > 0) state.bag.supp_base--;
  else if ((state.storage.supp_base || 0) > 0) state.storage.supp_base--;
  else { bgm.playSE("error"); log("サプリの素がない（プラント屋で購入できる）。"); return; }
  state.refiners[i] = { plantedTurn: state.turn, growRequired: REFINE_TURNS, status: "processing" };
  bgm.playSE("confirm");
  log(`精製ユニット${i + 1}にサプリの素をセットした（${REFINE_TURNS}ターンで精製サプリ×${REFINE_OUT_QTY}）。`);
  advanceTurns(1);
  render();
}
function finishRefine(i) {
  syncRefinerStates();
  const r = state.refiners[i];
  if (!r || r.status !== "ready") { bgm.playSE("error"); log("まだ精製が終わっていない。"); return; }
  state.refiners[i] = null;
  state.storage.supp_mid = (state.storage.supp_mid || 0) + REFINE_OUT_QTY;
  const expMsg = gainExp(8);
  bgm.playSE("loot");
  log(`精製ユニット${i + 1}から「精製サプリ」を${REFINE_OUT_QTY}個回収した（倉庫へ）。${expMsg}`);
  render();
}

function plantCrop(idx, seedKey) {
  syncPlotGrowthStates();
  const p = state.plots[idx];
  if (!p || p.status !== "empty") { bgm.playSE("error"); log("この区画は空きではない。"); return; }
  const key = SEED_KEYS.includes(seedKey) ? seedKey : "herb_seed";
  const seedHave = (state.bag[key] || 0) + (state.storage[key] || 0);
  if (seedHave <= 0) {
    bgm.playSE("error");
    log(`「${ITEMS[key].name}」を持っていないため植えられない！探索やドロップで見つけよう。`);
    return;
  }
  const seedDef = ITEMS[key];
  if ((state.bag[key] || 0) > 0) state.bag[key]--; else state.storage[key]--;
  p.status = "growing";
  p.plantedTurn = state.turn;
  p.seedKey = key;
  p.cropKey = seedDef.cropKey || "herb_low";
  p.growRequired = seedDef.growTurns || GROW_TURNS_REQUIRED;
  advanceTurns(1);
  bgm.playSE("confirm");
  log(`区画${idx + 1}に「${seedDef.name}」を植え付けた（1ターン経過／収穫まであと${Math.max(1, p.growRequired - (state.turn - p.plantedTurn))}ターンで${seedDef.cropName || "ハーブ"}が育つ）。`);
  render();
}
function harvestPlot(idx) {
  syncPlotGrowthStates();
  const p = state.plots[idx];
  if (!p || p.status !== "ready") { bgm.playSE("error"); log("まだ収穫可になっていない。"); return; }
  const cropKey = p.cropKey || "herb_low";
  const cropItem = ITEMS[cropKey] || ITEMS.herb_low;
  const count = DEFAULT_HARVEST_YIELD;
  const toSt = count;
  state.storage[cropKey] = (state.storage[cropKey] || 0) + toSt;
  state.plots[idx] = createEmptyPlot();
  const expMsg = gainExp(12);
  bgm.playSE("loot");
  log(`区画${idx + 1}から「${cropItem.name}」を${count}個収穫！（全て倉庫へ +${toSt}）${expMsg}`);
  render();
}

function restHome() {
  state.hp = Math.min(state.maxHp, state.hp + 10);
  advanceTurns(3);
  bgm.playSE("heal");
  log("自宅で3ターン休養し、HPが10回復した。");
  render();
}

function moveStorage(key, dir) {
  const qKey = "st_" + key + "_" + dir;
  if (dir === "toStorage") {
    const have = state.bag[key] || 0; const qty = getQty(qKey, have, 1);
    if (qty <= 0 || have < qty) { bgm.playSE("error"); log("手持ちが足りない。"); return; }
    state.bag[key] -= qty; state.storage[key] = (state.storage[key] || 0) + qty;
    if (state.equippedWeapon === key && (state.bag[key] || 0) <= 0) state.equippedWeapon = null;
    if (state.equippedArmor === key && (state.bag[key] || 0) <= 0) state.equippedArmor = null;
    bgm.playSE("confirm");
    log(`${ITEMS[key].name} を ${qty}個 倉庫へ入れた。`);
  } else {
    const have = state.storage[key] || 0; const space = state.carryMax - totalCarried();
    const qty = getQty(qKey, Math.min(have, space), 1);
    if (qty <= 0 || have < qty || space < qty) { bgm.playSE("error"); log("倉庫在庫が足りないか、手持ち上限オーバー。"); return; }
    state.storage[key] -= qty; state.bag[key] = (state.bag[key] || 0) + qty;
    bgm.playSE("confirm");
    log(`${ITEMS[key].name} を ${qty}個 手持ちに出した。`);
