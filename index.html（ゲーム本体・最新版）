function enterDungeonFromEntrance(spotKey) {
  const def = DUNGEONS[spotKey];
  const st = state.dungeon[spotKey];
  st.x = def.spawn.x; st.y = def.spawn.y; st.dir = def.spawn.dir;
  st.visited.add(`${st.x},${st.y}`);
  for (const dk of Object.keys(state.dungeon)) { state.dungeon[dk].chests = spawnChestsFor(dk); state.dungeon[dk].chestsRevealed = false; }
  state.npcBoughtCount = {};
  state.currentDungeon = spotKey;
  state.locationMode = "dungeon";
  state.tab = "outing";
  state.activeInteract = null;
  state.showQuestModalInDungeon = false;
  state.activeEnemy = null;
  state.guardBuffActive = false;
  advanceTurns(2);
  bgm.playSE("door");
  log(`【${def.name}】の入口ドアからダンジョンに入った（2ターン経過）。`);
  render();
  drawDungeon3D();
  syncCurrentBgmMode();
}

function enterContinuationDungeon(targetDungeonKey) {
  const fromDef = DUNGEONS[state.currentDungeon];
  const toDef = DUNGEONS[targetDungeonKey];
  if (!toDef) return;
  const toSt = state.dungeon[targetDungeonKey];
  toSt.x = toDef.spawn.x; toSt.y = toDef.spawn.y; toSt.dir = toDef.spawn.dir;
  toSt.visited.add(`${toSt.x},${toSt.y}`);
  toSt.roomIdx = 0;
  state.npcBoughtCount = {};

  state.currentDungeon = targetDungeonKey;
  state.locationMode = "dungeon";
  state.tab = "outing";
  state.activeInteract = null;
  state.showQuestModalInDungeon = false;
  state.activeEnemy = null;
  advanceTurns(1);
  bgm.playSE("door");
  log(`${fromDef.name}から続いて【${toDef.name}】の3Dダンジョンに入った（1ターン経過）。`);
  render();
  drawDungeon3D();
  syncCurrentBgmMode();
}

function returnToParentDungeon() {
  const curDef = DUNGEONS[state.currentDungeon];
  const parentKey = curDef.parentDungeon;
  if (!parentKey || !DUNGEONS[parentKey]) return;
  const parentDef = DUNGEONS[parentKey];
  const parentSt = state.dungeon[parentKey];
  parentSt.x = 1; parentSt.y = 1; parentSt.dir = 2;
  parentSt.visited.add(`${parentSt.x},${parentSt.y}`);

  state.currentDungeon = parentKey;
  state.locationMode = "dungeon";
  state.activeInteract = null;
  state.showQuestModalInDungeon = false;
  state.activeEnemy = null;
  advanceTurns(1);
  bgm.playSE("door");
  log(`【${curDef.name}】を出て【${parentDef.name}】へ戻った（1ターン経過）。`);
  render();
  drawDungeon3D();
  syncCurrentBgmMode();
}

function returnHomeFromGate() {
  const { def, isGate } = getDungeonCtx();
  if (state.locationMode === "dungeon" && !isGate) {
    bgm.playSE("error");
    log(`【帰還不可】ここは入口ドアではない！緑色の「入口ドア」マスまで移動しよう。`);
    return;
  }
  state.locationMode = "home";
  state.tab = "home";
  state.homeSub = "living";
  state.activeInteract = null;
  state.showQuestModalInDungeon = false;
  state.activeEnemy = null;
  state.guardBuffActive = false;
  advanceTurns(2);
  bgm.playSE("door");
  log(`${def.name}の入口ドアから自宅へ帰還した（2ターン経過）。`);
  render();
  syncCurrentBgmMode();
}

function switchHomeSub(sub) { bgm.playSE("select"); state.homeSub = sub; render(); }

function switchBarSub(sub) {
  if (state.barSub === "game" && sub !== "game") stopBongGame();
  bgm.playSE("select");
  state.barSub = sub;
  render();
  if (sub === "game") {
    requestAnimationFrame(() => initBongGame());
  }
  syncCurrentBgmMode();
}

function toggleDungeonQuestBox() {
  bgm.playSE("select");
  state.showQuestModalInDungeon = !state.showQuestModalInDungeon;
  render();
  drawDungeon3D();
}

function getDungeonCtx() {
  const spot = state.currentDungeon;
  const def = DUNGEONS[spot];
  const st = state.dungeon[spot];
  const cell = def.grid[st.y][st.x];
  const key = `${st.x},${st.y}`;
  const npc = cell === 3 ? (def.npcs[key] || null) : null;
  const isGate = cell === 9;
  const isSubReturn = cell === 8;

  const vec = DIR_VECTORS[st.dir];
  const fx = st.x + vec.dx;
  const fy = st.y + vec.dy;
  const frontKey = `${fx},${fy}`;
  const frontIsWall =
    fy < 0 || fy >= def.grid.length || fx < 0 || fx >= def.grid[0].length || def.grid[fy][fx] === 1;
  const frontDoor = (frontIsWall && def.wallDoors && def.wallDoors[frontKey]) ? def.wallDoors[frontKey] : null;

  return { spot, def, st, cell, key, npc, isGate, isSubReturn, frontDoor, frontKey };
}

function turnDungeon(delta) {
  if (state.activeEnemy) { bgm.playSE("error"); return; }
  const { def, st } = getDungeonCtx();
  st.dir = (st.dir + delta + 4) % 4;
  state.activeInteract = null;
  bgm.playSE("step");
  const { frontDoor } = getDungeonCtx();
  if (frontDoor) {
    log(`${def.name}で${DIR_VECTORS[st.dir].name}を向いた。目の前の壁に【${frontDoor.name}】のドアがある！`);
  } else {
    log(`${def.name}で${DIR_VECTORS[st.dir].name}を向いた。`);
  }
  render();
  drawDungeon3D();
}

function moveDungeon(step) {
  if (state.activeEnemy) { bgm.playSE("error"); log("敵と対峙中だ！攻撃・回復・逃げるを選ぼう。"); return; }
  const { def, st } = getDungeonCtx();
  const vec = DIR_VECTORS[st.dir];
  const nx = st.x + vec.dx * step;
  const ny = st.y + vec.dy * step;

  if (ny < 0 || ny >= def.grid.length || nx < 0 || nx >= def.grid[0].length || def.grid[ny][nx] === 1) {
    const wallKey = `${nx},${ny}`;
    const wDoor = def.wallDoors && def.wallDoors[wallKey];
    bgm.playSE("error");
    if (wDoor && step > 0) {
      log(`目の前の壁面に【${wDoor.name}】のドアがある！「ドアを開ける」で中に入れる。`);
    } else {
      log("完全な壁に阻まれて進めない。");
    }
    return;
  }

  st.x = nx; st.y = ny;
  const nKey = `${nx},${ny}`;
  st.visited.add(nKey);
  state.activeInteract = null;
  advanceTurns(1);

  const nextCell = def.grid[ny][nx];
  if (nextCell === 9) {
    bgm.playSE("confirm");
    log(`${def.name}の【入口ドア】のマスに立った。「入口ドアから帰る」で街へ戻れる。`);
  } else if (nextCell === 8 && def.parentDungeon) {
    bgm.playSE("confirm");
    log(`${def.name}の【${def.parentLabel}への戻りドア】のマスに立った。`);
  } else if (nextCell === 3 && def.npcs[nKey]) {
    bgm.playSE("confirm");
    log(`【${def.npcs[nKey].name}】がいる。「話す」で会話できる。`);
  } else {
    if (Math.random() < def.encounterRate) {
      const tpl = def.enemies[Math.floor(Math.random() * def.enemies.length)];
      state.activeEnemy = { ...tpl, maxHp: tpl.hp };
      state.guardBuffActive = false;
      bgm.playSE("damage");
      log(`【遭遇】${def.name}で【${tpl.name}】が立ちはだかった！`);
      syncCurrentBgmMode();
      render();
      drawDungeon3D();
      return;
    }
    bgm.playSE("step");
    const { frontDoor } = getDungeonCtx();
    const doorHint = frontDoor ? `（目の前の壁に【${frontDoor.name}】のドアあり！）` : "";
    log(`${def.name}を${step > 0 ? "前進" : "後退"}（座標 ${nx},${ny}・${DIR_VECTORS[st.dir].name}向き）${doorHint}`);
  }

  render();
  drawDungeon3D();
}

function interactDungeonHere() {
  if (state.activeEnemy) return;
  const { def, st, cell, key, npc, isGate, isSubReturn, frontDoor, frontKey } = getDungeonCtx();
  if (frontDoor) {
    if (frontDoor.kind === "sub_dungeon" && frontDoor.targetDungeon) {
      enterContinuationDungeon(frontDoor.targetDungeon);
      return;
    }
    state.activeInteract = { type: "door", key: frontKey };
    bgm.playSE("door");
    log(`壁面ドアを開けて【${frontDoor.name}】を調べた。`);
  } else if (isSubReturn && def.parentDungeon) {
    returnToParentDungeon();
    return;
  } else if (isGate) {
    state.activeInteract = { type: "gate", key };
    bgm.playSE("confirm");
    log(`${def.name}の入口ドアだ。ここから街へ戻れる。`);
  } else if (cell === 3 && npc) {
    state.activeInteract = { type: "npc", key };
    bgm.playSE("confirm");
    log(`${npc.name} ${npc.lines[0]}`);
  } else if (st.chests && st.chests[key]) {
    const chestItem = st.chests[key];
    if (totalCarried() >= state.carryMax) {
      bgm.playSE("error");
      log("手持ち枠がいっぱいで宝箱を開けられない。");
    } else {
      delete st.chests[key];
      state.bag[chestItem] = (state.bag[chestItem] || 0) + 1;
      advanceTurns(1);
      bgm.playSE("loot");
      log(`🎁 宝箱を開けた！「${ITEMS[chestItem].name}」を手に入れた（1ターン経過）！`);
    }
  } else {
    advanceTurns(1);
    bgm.playSE("step");
    log("周囲を調べた（1ターン経過）。");
  }
  render();
  drawDungeon3D();
}

function calcEnemyTakenDamage(rawAtk) {
  return Math.max(1, rawAtk - currentDefensePower());
}

const ENEMY_DROPS = {
  drunk:    [["tonic", 0.35], ["bento", 0.25]],
  thug:     [["iron_pipe", 0.18], ["tonic", 0.25], ["antique_coin", 0.08]],
  yankee:   [["biker_jacket", 0.15], ["herb_seed", 0.20]],
  dog:      [["herb_seed", 0.18], ["tonic", 0.18]],
  monpe:    [["kitchen_knife", 0.18], ["bento", 0.30], ["antique_vase", 0.08]],
  yakuza:   [["custom_stun_gun", 0.10], ["yakuza_suit", 0.10], ["gold_watch", 0.18], ["supp_high", 0.25], ["nihonto", 0.04]],
  hangure:  [["iron_chain", 0.18], ["antique_coin", 0.22], ["supp_low", 0.25]],
  madman:   [["herb_seed_phantom", 0.08], ["herb_seed", 0.25]],
  addict:   [["supp_low", 0.30], ["herb_seed", 0.18]],
  doberman: [["herb_seed_high", 0.15], ["first_aid_kit", 0.25]],
  police:   [["first_aid_kit", 0.20], ["tonic", 0.25], ["antique_coin", 0.06]],
  matori:   [["supp_mid", 0.25], ["first_aid_kit", 0.20], ["herb_seed_high", 0.10], ["supp_base", 0.15]],
  undercover: [["iron_chain", 0.08], ["supp_low", 0.25], ["herb_seed", 0.15]]
};

function rollEnemyDrop(kind) {
  const table = ENEMY_DROPS[kind] || [];
  const got = [];
  const missed = [];
  for (const [key, rate] of table) {
    if (!ITEMS[key]) continue;
    if (Math.random() < rate) {
      if (totalCarried() >= state.carryMax) missed.push(ITEMS[key].name);
      else { state.bag[key] = (state.bag[key] || 0) + 1; got.push(ITEMS[key].name); }
    }
  }
  let msg = "";
  if (got.length) msg += `／★ドロップ：${got.join("、")} を手に入れた！`;
  if (missed.length) msg += `／★${missed.join("、")}を落としたが、手持ちがいっぱいで拾えなかった`;
  return msg;
}
function attackEnemy() {
  const en = state.activeEnemy;
  if (!en) return;
  const dmg = currentAttackPower();
  en.hp -= dmg;
  advanceTurns(1);
  if (en.hp <= 0) {
    state.gold += en.gold;
    const expMsg = gainExp(en.exp || 25);
    const dropMsg = rollEnemyDrop(en.kind);
    state.activeEnemy = null;
    state.guardBuffActive = false;
    bgm.playSE("win");
    log(`【${en.name}】を撃退！¥${en.gold.toLocaleString()} を手に入れた（1ターン経過）${expMsg}${dropMsg}`);
    syncCurrentBgmMode();
    render(); drawDungeon3D();
    return;
  }
  const taken = calcEnemyTakenDamage(en.atk);
  state.hp = Math.max(1, state.hp - taken);
  bgm.playSE("attack");
  setTimeout(() => bgm.playSE("damage"), 110);
  log(`【${en.name}】に${dmg}ダメージ！反撃で${taken}ダメージを受けた（防御軽減${currentDefensePower()}／残りHP ${state.hp}/${state.maxHp}）。`);
  render(); drawDungeon3D();
}


function useLighterHere() {
  const { st } = getDungeonCtx();
  if ((state.bag.pocket_light || 0) <= 0) { bgm.playSE("error"); log("ライターを持っていない。"); return; }
  if (st.chestsRevealed) { bgm.playSE("error"); log("すでに宝箱の気配は掴んでいる。"); return; }
  state.bag.pocket_light--;
  st.chestsRevealed = true;
  bgm.playSE("confirm");
  log("使い捨てライターで辺りを照らした。このダンジョンの宝箱の位置がミニマップに金色で表示されるようになった。");
  render();
  drawDungeon3D();
}

function useUsableItem(itemKey, inBattle = false) {
  const item = ITEMS[itemKey];
  if (!item || !item.heal) return;
  if ((state.bag[itemKey] || 0) <= 0) {
    bgm.playSE("error");
    log(`手持ちに ${item.name} がない。`);
    return;
  }
  if (state.hp >= state.maxHp) {
    bgm.playSE("error");
    log("HPはすでに満タンだ。");
    return;
  }
  state.bag[itemKey]--;
  const beforeHp = state.hp;
  state.hp = Math.min(state.maxHp, state.hp + item.heal);
  const healed = state.hp - beforeHp;
  bgm.playSE("heal");

  if (inBattle && state.activeEnemy) {
    const taken = calcEnemyTakenDamage(state.activeEnemy.atk);
    state.hp = Math.max(1, state.hp - taken);
    advanceTurns(1);
    setTimeout(() => bgm.playSE("damage"), 180);
    log(`${item.name} でHP+${healed}回復！敵の攻撃で${taken}ダメージ（現在HP ${state.hp}/${state.maxHp}）。`);
    render();
    drawDungeon3D();
  } else {
    advanceTurns(1);
    log(`${item.name} を使い、HPが${healed}回復した（1ターン経過／現在HP ${state.hp}/${state.maxHp}）。`);
    render();
    if (state.locationMode === "dungeon") drawDungeon3D();
  }
}

function fleeEnemy() {
  const en = state.activeEnemy;
  if (!en) return;
  advanceTurns(1);
  if (Math.random() < 0.75) {
    state.activeEnemy = null;
    state.guardBuffActive = false;
    bgm.playSE("confirm");
    log(`【${en.name}】からうまく振り切った（1ターン経過）。`);
    syncCurrentBgmMode();
  } else {
    const taken = calcEnemyTakenDamage(Math.floor(en.atk * 0.6));
    state.hp = Math.max(1, state.hp - taken);
    bgm.playSE("damage");
    log(`逃げ切れず${taken}ダメージを受けた（残りHP ${state.hp}/${state.maxHp}）。`);
  }
  render(); drawDungeon3D();
}

function sellBulkToFacility(itemKey, price) {
  const have = state.bag[itemKey] || 0;
  const qty = getQty("bb_" + itemKey, have, 1);
  if (qty <= 0 || have < qty) { bgm.playSE("error"); log("手持ちが足りない。"); return; }
  state.bag[itemKey] -= qty;
  state.gold += price * qty;
  const expMsg = gainExp(Math.min(20, 2 + Math.floor(qty / 10)));
  bgm.playSE("sell");
  log(`${ITEMS[itemKey].name} を ${qty}個 まとめて売った（+¥${(price * qty).toLocaleString()}）。${expMsg}`);
  advanceTurns(1);
  render();
}

function buyWholesale(itemKey, unitPrice, facilityKind, minQty = 1) {
  const maxBuy = Math.max(0, Math.min(state.carryMax - totalCarried(), Math.floor(state.gold / unitPrice)));
  if (maxBuy < minQty) { bgm.playSE("error"); log(`この仕入先は大口（最低${minQty}個）が必要だ。所持金や手持ち枠が足りない。`); return; }
  const qty = getQty("ws_" + itemKey, maxBuy, minQty);
  if (qty < minQty) { bgm.playSE("error"); log(`最低 ${minQty}個 以上の大口仕入が必要だ。`); return; }
  const cost = unitPrice * qty;
  state.gold -= cost;
  state.bag[itemKey] = (state.bag[itemKey] || 0) + qty;
  const expMsg = gainExp(Math.max(10, Math.floor(qty / 5)));
  advanceTurns(1);

  let extraMsg = "";
  if (facilityKind === "yakuza_wholesale" && Math.random() < 0.35) {
    const taken = Math.max(1, 5 - currentDefensePower());
    state.hp = Math.max(1, state.hp - taken);
    bgm.playSE("damage");
    extraMsg = ` ※ヤクザの事務所で面倒事に巻き込まれ、HPが${taken}減った！`;
  } else if (facilityKind === "foreign_wholesale" && Math.random() < 0.35) {
    const taken = Math.max(1, 4 - currentDefensePower());
    state.hp = Math.max(1, state.hp - taken);
    bgm.playSE("damage");
    extraMsg = ` ※血の気の早い不良外人と一悶着あり、HPが${taken}減った！`;
  } else {
    bgm.playSE("confirm");
  }
  log(`${ITEMS[itemKey].name} を ${qty}個（¥${cost.toLocaleString()}）大口仕入した（1ターン経過）${expMsg}${extraMsg}`);
  render(); drawDungeon3D();
}

function buyPlantSlotUnit() {
  if (state.plots.length >= MAX_PLANT_SLOTS) { bgm.playSE("error"); log(`栽培区画はすでに最大（${MAX_PLANT_SLOTS}区画）だ。`); return; }
  const nextNum = state.plots.length + 1;
  const price = 15000 + (nextNum - 3) * 8000;
  if (state.gold < price) { bgm.playSE("error"); log(`お金が足りない（¥${price.toLocaleString()} 必要）。`); return; }
  state.gold -= price;
  state.plots.push(createEmptyPlot());
  advanceTurns(1);
  bgm.playSE("confirm");
  log(`プラント屋で栽培設備を導入し、区画${nextNum}を増設した（¥${price.toLocaleString()}／現在 ${state.plots.length}/${MAX_PLANT_SLOTS} 区画）。`);
  render(); drawDungeon3D();
}

function buyDungeonShopItem(itemKey, price) {
  if (totalCarried() >= state.carryMax) { bgm.playSE("error"); log("手持ち枠がいっぱいだ。"); return; }
  if (state.gold < price) { bgm.playSE("error"); log("お金が足りない。"); return; }
  state.gold -= price;
  state.bag[itemKey] = (state.bag[itemKey] || 0) + 1;
  advanceTurns(1);
  bgm.playSE("confirm");
  log(`${ITEMS[itemKey].name} を ¥${price.toLocaleString()} で購入した（1ターン経過）。`);
  render(); drawDungeon3D();
}

function selectSubRoom(idx) {
  const { spot, frontDoor } = getDungeonCtx();
  const fac = frontDoor || (state.activeInteract && DUNGEONS[spot].wallDoors[state.activeInteract.key]);
  if (!fac || !fac.rooms) return;
  const st = state.dungeon[spot];
  st.roomIdx = Math.max(0, Math.min(fac.rooms.length - 1, idx));
  advanceTurns(1);
  bgm.playSE("door");
  log(`【${fac.rooms[st.roomIdx].name}】を調べた（1ターン経過）。`);
  render(); drawDungeon3D();
}

function collectRoomLoot(codeId, itemKey) {
  const { spot } = getDungeonCtx();
  const st = state.dungeon[spot];
  if (st.collectedLoots.has(codeId)) { bgm.playSE("error"); log("すでに回収済みだ。"); return; }
  if (totalCarried() >= state.carryMax) { bgm.playSE("error"); log("手持ち枠がいっぱいだ。"); return; }
  st.collectedLoots.add(codeId);
  state.bag[itemKey] = (state.bag[itemKey] || 0) + 1;
  advanceTurns(1);
  bgm.playSE("loot");
  if (itemKey === "card_key") {
    state.mainStage = Math.max(state.mainStage, 2);
    log("「カードキー」を手に入れた！これで地下街のプラント屋に入れる（1ターン経過）。★メインクエスト進行！");
  } else {
    log(`「${ITEMS[itemKey].name}」を手に入れた（1ターン経過）！`);
  }
  render(); drawDungeon3D();
}

function getNpcRemainingQuota(buyerId, buyLimit) {
  if (!buyLimit || buyLimit <= 0) return 0;
  const used = state.npcBoughtCount[buyerId] || 0;
  return Math.max(0, buyLimit - used);
}

function sellItemToBuyer(buyerId, buyerName, buyLimit, itemKey, unitPrice) {
  if (ITEMS[itemKey] && ITEMS[itemKey].group === "antique") { bgm.playSE("error"); log("骨董品はNPCには売れない（商店で換金しよう）。"); return; }
  const rem = getNpcRemainingQuota(buyerId, buyLimit);
  if (rem <= 0) { bgm.playSE("error"); log(`${buyerName} はこれ以上買う枠がない（購入上限に達した）。`); return; }
  const have = state.bag[itemKey] || 0;
  const maxSell = Math.min(have, rem);
  const qty = getQty("sell_" + buyerId + "_" + itemKey, maxSell, 1);
  if (qty <= 0 || maxSell < qty) { bgm.playSE("error"); log(`${ITEMS[itemKey].name} を売れない。`); return; }

  state.bag[itemKey] -= qty;
  state.npcBoughtCount[buyerId] = (state.npcBoughtCount[buyerId] || 0) + qty;
  const gain = unitPrice * qty;
  state.gold += gain;
  const expMsg = gainExp(12 * qty);
  advanceTurns(1);
  bgm.playSE("confirm");
  log(`${buyerName} に ${ITEMS[itemKey].name} を ${qty}個 売り、¥${gain.toLocaleString()} を得た（残り購入枠 ${rem - qty}個）${expMsg}`);
  render(); drawDungeon3D();
}

function sellAntiqueInShop(key) {
  const item = ITEMS[key];
  if (!item || item.group !== "antique") return;
  const have = state.bag[key] || 0;
  const qty = getQty("shop_sell_" + key, have, 1);
  if (qty <= 0 || have < qty) { bgm.playSE("error"); log(`${item.name} を持っていない。`); return; }
  state.bag[key] -= qty;
  const gain = (item.sellPrice || 1000) * qty;
  state.gold += gain;
  const expMsg = gainExp(15 * qty);
  advanceTurns(1);
  bgm.playSE("confirm");
  log(`商店で骨董品「${item.name}」を ${qty}個 換金し、¥${gain.toLocaleString()} を受け取った${expMsg}`);
  render();
}

function resetQuestProgress() { state.questProgress.foundPerson = false; state.questProgress.collectedGold = false; }

function acceptQuest(qId) {
  if (state.activeQuestId) { bgm.playSE("error"); log("同時に受けられる依頼は1件までだ。"); return; }
  state.activeQuestId = qId;
  resetQuestProgress();
  const q = QUESTS.find(x => x.id === qId);
  bgm.playSE("confirm");
  log(`依頼「${q.title}」を受注。目的地は【${q.targetPerson}】。`);
  render();
}

function cancelQuest() { state.activeQuestId = null; resetQuestProgress(); bgm.playSE("select"); log("依頼を破棄した。"); render(); }

function totalHerbsAvailable() {
  return (state.bag.herb_low || 0) + (state.bag.herb_high || 0) + (state.storage.herb_low || 0) + (state.storage.herb_high || 0);
}

function consumeHerbsForQuest(needed) {
  let rem = needed;
  for (const k of ["herb_low", "herb_high"]) {
    const fromBag = Math.min(state.bag[k] || 0, rem);
    state.bag[k] -= fromBag; rem -= fromBag;
  }
  for (const k of ["herb_low", "herb_high"]) {
    if (rem <= 0) break;
    const fromSt = Math.min(state.storage[k] || 0, rem);
    state.storage[k] -= fromSt; rem -= fromSt;
  }
}

function completeQuest(q, spot) {
  if (!q || spot !== q.targetSpot) return;
  if (q.kind === "delivery") {
    if (totalHerbsAvailable() < q.needQty) { bgm.playSE("error"); log("ハーブが足りない。"); return; }
    consumeHerbsForQuest(q.needQty);
  } else if (q.kind === "search") {
    if (!state.questProgress.foundPerson) { bgm.playSE("error"); log("先に安否を確認しよう。"); return; }
  } else if (q.kind === "collect") {
    if (!state.questProgress.collectedGold) { bgm.playSE("error"); log("先に町外れで未払い金を回収しよう。"); return; }
  }
  state.gold += q.rewardGold;
  const expMsg = gainExp(q.rewardExp || 60);
  state.activeQuestId = null;
  resetQuestProgress();
  advanceTurns(2);
  bgm.playSE("win");
  log(`依頼「${q.title}」完了！報酬 ¥${q.rewardGold.toLocaleString()} を受け取った（2ターン経過）${expMsg}`);
  render(); drawDungeon3D();
}

function drawWallDoor(ctx, x0, y0, ww, hh, def, shade, labelTop, labelMain, accentColor) {
  ctx.save(); ctx.globalAlpha = shade; ctx.fillStyle = def.wallColor; ctx.fillRect(x0, y0, ww, hh);
  ctx.strokeStyle = def.wallAccent; ctx.lineWidth = 2; ctx.strokeRect(x0, y0, ww, hh);

  const doorW = Math.max(22, ww * 0.48); const doorH = Math.max(28, hh * 0.78);
  const dx = x0 + (ww - doorW) / 2; const dy = y0 + hh - doorH;

  ctx.fillStyle = "#090d1a"; ctx.fillRect(dx - 4, dy - 4, doorW + 8, doorH + 4);
  ctx.strokeStyle = accentColor; ctx.lineWidth = 3; ctx.strokeRect(dx - 4, dy - 4, doorW + 8, doorH + 4);

  ctx.fillStyle = "#1e293b"; ctx.fillRect(dx, dy, doorW, doorH);
  ctx.strokeStyle = "rgba(255,255,255,0.28)"; ctx.lineWidth = 1.5;
  ctx.strokeRect(dx + doorW * 0.14, dy + doorH * 0.12, doorW * 0.72, doorH * 0.34);
  ctx.strokeRect(dx + doorW * 0.14, dy + doorH * 0.54, doorW * 0.72, doorH * 0.32);

