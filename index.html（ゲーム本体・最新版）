            this.floatingTexts = [];
            this.boss = null;

            // 主人公「ボングくん」初期化
            this.player = {
                x: this.width / 2,
                y: this.height - 110,
                radius: 18,
                life: 3,
                maxLife: 5,
                speed: 310,
                shootTimer: 0,
                fireRate: 0.22,     // 発射間隔（秒）
                wayCount: 1,       // 煙の列数 (1〜5)
                bulletSpeed: 480,
                bears: 0,          // デッドベア子機数 (0〜2)
                bearColors: [BEAR_COLORS[0], BEAR_COLORS[1]],
                invulnTimer: 2.0,  // 被弾後無敵時間
                shieldTimer: 0,    // サングラス無敵バリア時間
                mushroomTimer: 0,  // キノコ巨大貫通時間
                rainbowTimer: 0,   // 虹レインボー煙時間
                animPhase: 0
            };

            this.titleScreen.classList.add('hidden');
            this.pauseScreen.classList.add('hidden');
            this.gameOverScreen.classList.add('hidden');
            this.highScoreModal.classList.add('hidden');
            this.hud.classList.remove('hidden');
            this.pauseBtn.classList.remove('hidden');
            this.pauseBtn.textContent = '⏸';
            this.bossHpContainer.classList.add('hidden');

            sound.startBGM('normal', this.getNormalBgmVar(1), this.getBossBgmVar(1));
            this.updateHUD();
            this.addFloatingText(this.width / 2, this.height * 0.45, 'STAGE 1 START!', '#38bdf8', 26);
        }

        togglePause(forcePause = null) {
            if (this.state !== 'PLAYING' && this.state !== 'PAUSED') return;
            const nextPause = forcePause !== null ? Boolean(forcePause) : (this.state === 'PLAYING');

            if (nextPause) {
                this.state = 'PAUSED';
                this.pointer.active = false;
                this.keys = {};
                sound.stopBGM(true);
                this.pauseBtn.textContent = '▶';
                this.pauseScreen.classList.remove('hidden');
            } else {
                this.state = 'PLAYING';
                this.lastTime = performance.now();
                this.pauseBtn.textContent = '⏸';
                this.pauseScreen.classList.add('hidden');
                this.highScoreModal.classList.add('hidden');
                const mode = this.boss ? 'boss' : 'normal';
                sound.startBGM(mode, this.getNormalBgmVar(this.stage), this.getBossBgmVar(this.stage));
            }
        }

        returnToTitle() {
            this.state = 'TITLE';
            this.pointer.active = false;
            this.keys = {};
            sound.stopBGM(true);
            this.hud.classList.add('hidden');
            this.pauseBtn.classList.add('hidden');
            this.pauseScreen.classList.add('hidden');
            this.gameOverScreen.classList.add('hidden');
            this.bossHpContainer.classList.add('hidden');
            this.titleScreen.classList.remove('hidden');
        }

        openHighScoreModal() {
            this.highScoreEntries = loadHighScores();
            this.renderHighScoreList();
            this.highScoreModal.classList.remove('hidden');
        }

        renderHighScoreList() {
            if (!this.highScoreListEl) return;
            const entries = this.highScoreEntries;
            if (!entries || entries.length === 0) {
                this.highScoreListEl.innerHTML = `
                    <div class="py-10 text-center text-xs text-purple-200/75">
                        まだハイスコア記録がありません。<br>トリップして記録を残そう！
                    </div>
                `;
                return;
            }

            this.highScoreListEl.innerHTML = entries.map((item, idx) => {
                const medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : `#${idx + 1}`;
                const rowHighlight = idx === 0 ? 'bg-amber-400/15 border-amber-400/40' : 'bg-white/5 border-white/10';
                return `
                    <div class="flex items-center justify-between gap-2 rounded-2xl border ${rowHighlight} px-3 py-2 text-xs">
                        <div class="flex items-center gap-2.5 shrink-0">
                            <span class="w-7 text-center font-black text-amber-300 shrink-0">${medal}</span>
                            <span class="font-black text-sm text-white shrink-0 whitespace-nowrap">${item.score.toLocaleString()}</span>
                            <span class="rounded-lg bg-cyan-500/20 border border-cyan-400/30 px-2 py-0.5 text-[10px] font-bold text-cyan-200 shrink-0">STAGE ${item.stage}</span>
                        </div>
                        <span class="text-[10px] text-purple-200/75 min-w-0 truncate text-right">${item.date}</span>
                    </div>
                `;
            }).join('');
        }

        gameOver() {
            this.state = 'GAMEOVER';
            this.pointer.active = false;
            sound.stopBGM(true);

            this.highScoreEntries = recordHighScore(this.score, this.stage);
            this.highScore = this.highScoreEntries.length > 0
                ? Math.max(this.highScore, this.highScoreEntries[0].score)
                : Math.max(this.highScore, this.score);

            this.hud.classList.add('hidden');
            this.pauseBtn.classList.add('hidden');
            this.pauseScreen.classList.add('hidden');
            this.bossHpContainer.classList.add('hidden');
            this.gameOverScreen.classList.remove('hidden');

            this.finalScoreEl.textContent = this.score.toLocaleString();
            this.finalStageEl.textContent = `STAGE ${this.stage}`;
            this.highScoreEl.textContent = this.highScore.toLocaleString();
        }

        updateHUD() {
            this.scoreEl.textContent = this.score.toLocaleString();
            this.stageEl.textContent = this.stage;
            this.lifeEl.textContent = '💚'.repeat(Math.max(0, this.player.life));

            // パワーアップ状態バッジ更新
            let badgesHTML = '';
            if (this.player.wayCount > 1) {
                badgesHTML += `<span class="px-2 py-0.5 rounded-full bg-green-500/30 border border-green-400 text-green-200 text-[10px] font-bold">🌿 ${this.player.wayCount}-WAY</span>`;
            }
            if (this.player.bears > 0) {
                badgesHTML += `<span class="px-2 py-0.5 rounded-full bg-purple-500/30 border border-purple-400 text-purple-200 text-[10px] font-bold">🧸 x${this.player.bears}</span>`;
            }
            if (this.player.mushroomTimer > 0) {
                badgesHTML += `<span class="px-2 py-0.5 rounded-full bg-red-500/40 border border-red-400 text-red-200 text-[10px] font-bold animate-pulse">🍄 TRIP ${Math.ceil(this.player.mushroomTimer)}s</span>`;
            }
            if (this.player.rainbowTimer > 0) {
                badgesHTML += `<span class="px-2 py-0.5 rounded-full bg-pink-500/40 border border-pink-400 text-pink-200 text-[10px] font-bold animate-pulse">🌈 RAINBOW ${Math.ceil(this.player.rainbowTimer)}s</span>`;
            }
            if (this.player.shieldTimer > 0) {
                badgesHTML += `<span class="px-2 py-0.5 rounded-full bg-cyan-500/40 border border-cyan-400 text-cyan-200 text-[10px] font-bold animate-pulse">🕶️ SHIELD ${Math.ceil(this.player.shieldTimer)}s</span>`;
            }
            this.badgesEl.innerHTML = badgesHTML;
        }

        addFloatingText(x, y, text, color = '#ffffff', size = 16) {
            this.floatingTexts.push({
                x, y, text, color, size,
                life: 1.1,
                maxLife: 1.1
            });
        }

        spawnParticles(x, y, color, count = 12, speed = 150) {
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const spd = Math.random() * speed + 30;
                this.particles.push({
                    x, y,
                    vx: Math.cos(angle) * spd,
                    vy: Math.sin(angle) * spd,
                    radius: Math.random() * 5 + 2,
                    color,
                    life: Math.random() * 0.4 + 0.25,
                    maxLife: 0.65
                });
            }
        }

        // ==========================================
        // 4. メインループ & 更新処理
        // ==========================================
        loop(timestamp) {
            const dt = Math.min((timestamp - this.lastTime) / 1000, 0.05);
            this.lastTime = timestamp;

            if (this.state !== 'PAUSED') {
                this.updateBackground(dt);
            }

            if (this.state === 'PLAYING') {
                this.updatePlaying(dt);
            }

            this.draw();
            requestAnimationFrame((t) => this.loop(t));
        }

        updateBackground(dt) {
            this.bgHue = (this.bgHue + dt * 15) % 360;

            for (const c of this.tieDyeClouds) {
                c.y += c.speed * dt;
                c.hue = (c.hue + dt * 20) % 360;
                if (c.y - c.radius > this.height) {
                    c.y = -c.radius;
                    c.x = Math.random() * this.width;
                }
            }
            for (const s of this.stars) {
                s.y += s.speed * dt;
                if (s.y > this.height) {
                    s.y = 0;
                    s.x = Math.random() * this.width;
                }
            }
        }

        updatePlaying(dt) {
            if (this.screenShake > 0) this.screenShake = Math.max(0, this.screenShake - dt * 25);
            if (this.munchiesFlash > 0) this.munchiesFlash = Math.max(0, this.munchiesFlash - dt * 2.2);

            this.updatePlayer(dt);
            this.updateStageAndSpawns(dt);
            this.updateBullets(dt);
            this.updateEnemies(dt);
            this.updateBoss(dt);
            this.updateEnemyBullets(dt);
            this.updateItems(dt);
            this.updateParticlesAndTexts(dt);

            // タイマー系HUDの定期更新
            if (Math.random() < 0.2) this.updateHUD();
        }

        updatePlayer(dt) {
            const p = this.player;
            p.animPhase += dt * 8;

            if (p.invulnTimer > 0) p.invulnTimer -= dt;
            if (p.shieldTimer > 0) p.shieldTimer -= dt;
            if (p.mushroomTimer > 0) p.mushroomTimer -= dt;
            if (p.rainbowTimer > 0) p.rainbowTimer -= dt;

            // キーボード移動
            let dx = 0, dy = 0;
            if (this.keys['ArrowLeft'] || this.keys['KeyA']) dx -= 1;
            if (this.keys['ArrowRight'] || this.keys['KeyD']) dx += 1;
            if (this.keys['ArrowUp'] || this.keys['KeyW']) dy -= 1;
            if (this.keys['ArrowDown'] || this.keys['KeyS']) dy += 1;

            if (dx !== 0 || dy !== 0) {
                const len = Math.hypot(dx, dy);
                p.x += (dx / len) * p.speed * dt;
                p.y += (dy / len) * p.speed * dt;
            } else if (this.pointer.active) {
                const diffX = this.pointer.x - p.x;
                const diffY = this.pointer.y - p.y;
                p.x += diffX * Math.min(1, dt * 18);
                p.y += diffY * Math.min(1, dt * 18);
            }

            // 画面内制限
            p.x = Math.max(24, Math.min(this.width - 24, p.x));
            p.y = Math.max(70, Math.min(this.height - 32, p.y));

            // 自動煙発射
            p.shootTimer -= dt;
            if (p.shootTimer <= 0) {
                p.shootTimer = p.fireRate;
                this.firePlayerSmoke();
            }
        }

        firePlayerSmoke() {
            const p = this.player;
            const isRainbow = p.rainbowTimer > 0;
            const isGiant = p.mushroomTimer > 0;
            sound.playShoot(isRainbow);

            const baseDamage = (isRainbow ? 2.2 : 1.0) * (isGiant ? 1.8 : 1.0);
            const baseRadius = (isGiant ? 20 : 10) * (isRainbow ? 1.25 : 1.0);
            const mouthY = p.y - 26;

            const ways = p.wayCount;
            const spreadAngle = 0.14;
            for (let i = 0; i < ways; i++) {
                const offsetIdx = i - (ways - 1) / 2;
                const angle = -Math.PI / 2 + offsetIdx * spreadAngle;
                this.bullets.push({
                    x: p.x + offsetIdx * 6,
                    y: mouthY,
                    vx: Math.cos(angle) * p.bulletSpeed,
                    vy: Math.sin(angle) * p.bulletSpeed,
                    radius: baseRadius,
                    damage: baseDamage,
                    isRainbow,
                    isPierce: isGiant,
                    hitEnemies: new Set(),
                    hue: (performance.now() * 0.3 + i * 40) % 360,
                    wobble: Math.random() * Math.PI * 2
                });
            }

            if (p.bears >= 1) {
                this.bullets.push({
                    x: p.x - 34,
                    y: p.y + 4,
                    vx: 0,
                    vy: -p.bulletSpeed * 0.95,
                    radius: baseRadius * 0.75,
                    damage: baseDamage * 0.7,
                    isRainbow,
                    isPierce: isGiant,
                    hitEnemies: new Set(),
                    hue: 120,
                    wobble: 0
                });
            }
            if (p.bears >= 2) {
                this.bullets.push({
                    x: p.x + 34,
                    y: p.y + 4,
                    vx: 0,
                    vy: -p.bulletSpeed * 0.95,
                    radius: baseRadius * 0.75,
                    damage: baseDamage * 0.7,
                    isRainbow,
                    isPierce: isGiant,
                    hitEnemies: new Set(),
                    hue: 280,
                    wobble: Math.PI
                });
            }
        }

        updateStageAndSpawns(dt) {
            if (this.boss) return;

            if (this.bossWarningTimer > 0) {
                this.bossWarningTimer -= dt;
                if (this.bossWarningTimer <= 0) {
                    this.spawnBoss();
                }
                return;
            }

            this.stageTimer += dt;
            const stageDuration = 22 + Math.min(this.stage * 3, 15);

            if (this.stageTimer >= stageDuration) {
                this.bossWarningTimer = 2.4;
                sound.playBossWarning();
                this.addFloatingText(this.width / 2, this.height * 0.35, '⚠️ WARNING! BOSS APPROACHING ⚠️', '#ef4444', 20);
                return;
            }

            this.spawnTimer -= dt;
            const spawnInterval = Math.max(0.45, 1.35 - this.stage * 0.12);
            if (this.spawnTimer <= 0) {
                this.spawnTimer = spawnInterval;
                this.spawnEnemy();
            }
        }

        spawnEnemy() {
            const isGangster = Math.random() < (0.3 + this.stage * 0.05);
            const margin = 38;
            const x = margin + Math.random() * (this.width - margin * 2);
            const hpScale = 1 + (this.stage - 1) * 0.35;

            if (!isGangster) {
                this.enemies.push({
                    type: 'police',
                    x,
                    y: -30,
                    vx: (Math.random() < 0.5 ? -1 : 1) * (40 + Math.random() * 40),
                    vy: 95 + this.stage * 10,
                    radius: 20,
                    hp: Math.ceil(3 * hpScale),
                    maxHp: Math.ceil(3 * hpScale),
                    shootTimer: 1.2 + Math.random() * 1.2,
                    score: 150,
                    phase: Math.random() * Math.PI * 2
                });
            } else {
                this.enemies.push({
                    type: 'gangster',
                    x,
                    y: -35,
                    vx: (Math.random() < 0.5 ? -1 : 1) * (75 + this.stage * 8),
                    vy: 55 + this.stage * 5,
                    radius: 23,
                    hp: Math.ceil(6 * hpScale),
                    maxHp: Math.ceil(6 * hpScale),
                    shootTimer: 1.0 + Math.random() * 1.0,
                    score: 300,
                    phase: Math.random() * Math.PI * 2
                });
            }
        }

        spawnBoss() {
            const bossTypes = [
                { name: 'CHIEF PATROL (巨大パトカーメカ)', kind: 'patrol', color: '#3b82f6' },
                { name: 'BIG BOSS GANGSTA (マフィアのドン)', kind: 'mafia', color: '#a855f7' },
                { name: 'PSYCHEDELIC CHOPPER (サイケヘリ)', kind: 'chopper', color: '#ec4899' }
            ];
            const template = bossTypes[(this.stage - 1) % bossTypes.length];
            const maxHp = Math.floor(110 * Math.pow(1.38, this.stage - 1));

            this.boss = {
                name: `ST.${this.stage} ${template.name}`,
                kind: template.kind,
                color: template.color,
                x: this.width / 2,
                y: -80,
                targetY: 145,
                vx: 85 + this.stage * 10,
                radius: 54,
                hp: maxHp,
                maxHp: maxHp,
                attackTimer: 1.5,
                patternIdx: 0,
                phase: 0
            };

            this.bossHpContainer.classList.remove('hidden');
            this.bossNameEl.textContent = this.boss.name;
            sound.setBgmMode('boss', this.getNormalBgmVar(this.stage), this.getBossBgmVar(this.stage));
            this.updateBossHpUI();
        }

        updateBossHpUI() {
            if (!this.boss) return;
            const pct = Math.max(0, (this.boss.hp / this.boss.maxHp) * 100);
            this.bossHpBar.style.width = `${pct}%`;
            this.bossHpText.textContent = `${Math.ceil(pct)}%`;
        }

        updateBullets(dt) {
            for (let i = this.bullets.length - 1; i >= 0; i--) {
                const b = this.bullets[i];
                b.wobble += dt * 12;
                b.x += b.vx * dt + Math.sin(b.wobble) * 18 * dt;
                b.y += b.vy * dt;
                b.hue = (b.hue + dt * 360) % 360;

                if (b.y + b.radius < -20 || b.x < -30 || b.x > this.width + 30) {
                    this.bullets.splice(i, 1);
                }
            }
        }

        updateEnemies(dt) {
            for (let i = this.enemies.length - 1; i >= 0; i--) {
                const e = this.enemies[i];
                e.phase += dt * 4;

                if (e.type === 'police') {
                    e.x += Math.sin(e.phase) * e.vx * dt;
                    e.y += e.vy * dt;
                } else {
                    e.x += e.vx * dt;
                    e.y += e.vy * dt;
                    if (e.x < 30 || e.x > this.width - 30) e.vx *= -1;
                }

                e.shootTimer -= dt;
                if (e.shootTimer <= 0 && e.y > 20 && e.y < this.height - 140) {
                    e.shootTimer = Math.max(1.1, 2.3 - this.stage * 0.15);
                    this.fireEnemyBullet(e);
                }

                let destroyed = false;
                for (let j = this.bullets.length - 1; j >= 0; j--) {
                    const b = this.bullets[j];
                    if (b.isPierce && b.hitEnemies.has(e)) continue;

                    const dist = Math.hypot(e.x - b.x, e.y - b.y);
                    if (dist < e.radius + b.radius) {
                        e.hp -= b.damage;
                        this.spawnParticles(b.x, b.y, b.isRainbow ? `hsl(${b.hue},100%,65%)` : '#e2e8f0', 4, 70);

                        if (b.isPierce) {
                            b.hitEnemies.add(e);
                        } else {
                            this.bullets.splice(j, 1);
                        }

                        if (e.hp <= 0) {
                            this.destroyEnemy(e);
                            this.enemies.splice(i, 1);
                            destroyed = true;
                            break;
                        }
                    }
                }
                if (destroyed) continue;

                const pDist = Math.hypot(e.x - this.player.x, e.y - this.player.y);
                if (pDist < e.radius + this.player.radius - 4) {
                    this.damagePlayer();
                    this.destroyEnemy(e);
                    this.enemies.splice(i, 1);
                    continue;
                }

                if (e.y - e.radius > this.height + 30) {
                    this.enemies.splice(i, 1);
                }
            }
        }

        fireEnemyBullet(e) {
            const angleToPlayer = Math.atan2(this.player.y - e.y, this.player.x - e.x);
            const speed = 190 + this.stage * 18;

            if (e.type === 'police') {
                this.enemyBullets.push({
                    x: e.x,
                    y: e.y + 15,
                    vx: Math.cos(angleToPlayer) * speed,
                    vy: Math.sin(angleToPlayer) * speed,
                    radius: 6,
                    color: '#38bdf8'
                });
            } else {
                [-0.16, 0.16].forEach(offset => {
                    this.enemyBullets.push({
                        x: e.x,
                        y: e.y + 15,
                        vx: Math.cos(angleToPlayer + offset) * (speed * 1.05),
                        vy: Math.sin(angleToPlayer + offset) * (speed * 1.05),
                        radius: 7,
                        color: '#f43f5e'
                    });
                });
            }
        }

        destroyEnemy(e) {
            sound.playExplosion(false);
            this.score += e.score;
            this.updateHUD();
            this.spawnParticles(e.x, e.y, e.type === 'police' ? '#60a5fa' : '#c084fc', 14, 140);

            if (Math.random() < 0.38) {
                this.spawnItem(e.x, e.y);
            }
        }

        updateBoss(dt) {
            const b = this.boss;
            if (!b) return;

            b.phase += dt * 3;
            if (b.y < b.targetY) {
                b.y += 70 * dt;
            } else {
                b.x += b.vx * dt;
                if (b.x < b.radius + 20 || b.x > this.width - b.radius - 20) {
                    b.vx *= -1;
                }
            }

            b.attackTimer -= dt;
            if (b.attackTimer <= 0 && b.y >= b.targetY - 5) {
                b.patternIdx = (b.patternIdx + 1) % 3;
                const speed = 210 + this.stage * 15;

                if (b.patternIdx === 0) {
                    b.attackTimer = Math.max(0.9, 1.5 - this.stage * 0.08);
                    const ways = 5 + Math.min(this.stage, 4);
                    for (let i = 0; i < ways; i++) {
                        const angle = Math.PI / 2 + (i - (ways - 1) / 2) * 0.22;
                        this.enemyBullets.push({
                            x: b.x,
                            y: b.y + 35,
                            vx: Math.cos(angle) * speed,
                            vy: Math.sin(angle) * speed,
                            radius: 8,
                            color: '#fb7185'
                        });
                    }
                } else if (b.patternIdx === 1) {
                    b.attackTimer = Math.max(0.8, 1.3 - this.stage * 0.06);
                    const baseAngle = Math.atan2(this.player.y - b.y, this.player.x - b.x);
                    [-0.12, 0, 0.12].forEach(off => {
                        this.enemyBullets.push({
                            x: b.x,
                            y: b.y + 30,
                            vx: Math.cos(baseAngle + off) * (speed * 1.15),
                            vy: Math.sin(baseAngle + off) * (speed * 1.15),
                            radius: 7,
                            color: '#facc15'
                        });
                    });
                } else {
                    b.attackTimer = Math.max(1.1, 1.7 - this.stage * 0.08);
                    const count = 10 + Math.min(this.stage * 2, 8);
                    for (let i = 0; i < count; i++) {
                        const angle = (Math.PI * 2 / count) * i + b.phase;
                        this.enemyBullets.push({
                            x: b.x,
                            y: b.y,
                            vx: Math.cos(angle) * (speed * 0.85),
                            vy: Math.sin(angle) * (speed * 0.85),
                            radius: 7,
                            color: '#38bdf8'
                        });
                    }
                }
            }

            for (let j = this.bullets.length - 1; j >= 0; j--) {
                const bul = this.bullets[j];
                if (bul.isPierce && bul.hitEnemies.has(b)) continue;

                const dist = Math.hypot(b.x - bul.x, b.y - bul.y);
                if (dist < b.radius + bul.radius) {
                    b.hp -= bul.damage;
                    this.spawnParticles(bul.x, bul.y, '#ffffff', 4, 80);

                    if (bul.isPierce) {
                        bul.hitEnemies.add(b);
                    } else {
                        this.bullets.splice(j, 1);
                    }

                    this.updateBossHpUI();

                    if (b.hp <= 0) {
                        this.defeatBoss();
                        return;
                    }
                }
            }

            const pDist = Math.hypot(b.x - this.player.x, b.y - this.player.y);
            if (pDist < b.radius + this.player.radius - 6) {
                this.damagePlayer();
            }
        }

        defeatBoss() {
            const b = this.boss;
            sound.playExplosion(true);
            this.screenShake = 18;
            this.enemyBullets = [];

            const bonus = 2000 * this.stage;
            this.score += bonus;
            this.spawnParticles(b.x, b.y, '#facc15', 45, 240);
            this.spawnParticles(b.x, b.y, '#f472b6', 35, 200);
            this.addFloatingText(b.x, b.y, `BOSS PURIFIED! +${bonus}`, '#fde047', 22);

            this.spawnItem(b.x - 30, b.y);
            this.spawnItem(b.x + 30, b.y);
            if (this.stage % 2 === 0) this.spawnItem(b.x, b.y - 20);

            this.boss = null;
            this.bossHpContainer.classList.add('hidden');

            this.stage++;
            this.stageTimer = 0;
            sound.setBgmMode('normal', this.getNormalBgmVar(this.stage), this.getBossBgmVar(this.stage));
            this.updateHUD();

            setTimeout(() => {
                if (this.state === 'PLAYING') {
                    this.addFloatingText(this.width / 2, this.height * 0.4, `STAGE ${this.stage} START!`, '#38bdf8', 26);
                }
            }, 1200);
        }

        updateEnemyBullets(dt) {
            for (let i = this.enemyBullets.length - 1; i >= 0; i--) {
                const eb = this.enemyBullets[i];
                eb.x += eb.vx * dt;
                eb.y += eb.vy * dt;

                const dist = Math.hypot(eb.x - this.player.x, eb.y - this.player.y);
                if (dist < eb.radius + this.player.radius - 7) {
                    this.enemyBullets.splice(i, 1);
                    this.damagePlayer();
                    continue;
                }

                if (eb.y > this.height + 20 || eb.y < -20 || eb.x < -20 || eb.x > this.width + 20) {
                    this.enemyBullets.splice(i, 1);
                }
            }
        }

        damagePlayer() {
            const p = this.player;
            if (p.invulnTimer > 0 || p.shieldTimer > 0) return;

            sound.playHit();
            this.screenShake = 14;
            p.life--;
            p.invulnTimer = 2.2;

            if (p.wayCount > 1) p.wayCount--;
            if (p.bears > 0) p.bears--;

            this.spawnParticles(p.x, p.y, '#ef4444', 22, 160);
            this.addFloatingText(p.x, p.y - 20, 'OUCH!!', '#f87171', 20);
            this.updateHUD();

            if (p.life <= 0) {
                this.gameOver();
            }
        }

        spawnItem(x, y) {
            const totalWeight = ITEM_TYPES.reduce((sum, item) => sum + item.weight, 0);
            let r = Math.random() * totalWeight;
            let selected = ITEM_TYPES[0];
            for (const item of ITEM_TYPES) {
                if (r < item.weight) {
                    selected = item;
                    break;
                }
                r -= item.weight;
            }

            this.items.push({
                ...selected,
                x,
                y,
                vy: 85,
                radius: 18,
                wobble: Math.random() * Math.PI * 2
            });
        }

        updateItems(dt) {
            for (let i = this.items.length - 1; i >= 0; i--) {
                const it = this.items[i];
                it.wobble += dt * 4;
                it.x += Math.sin(it.wobble) * 35 * dt;
                it.y += it.vy * dt;

                const dist = Math.hypot(it.x - this.player.x, it.y - this.player.y);
                if (dist < it.radius + this.player.radius + 10) {
                    this.applyItemEffect(it);
                    this.items.splice(i, 1);
                    continue;
                }

                if (it.y > this.height + 30) {
                    this.items.splice(i, 1);
                }
            }
        }

        applyItemEffect(item) {
            const p = this.player;
            this.score += 200;
            this.spawnParticles(item.x, item.y, item.color, 16, 130);

            if (item.id === 'pizza') {
                sound.playMunchiesVoice();
                this.munchiesFlash = 1.0;
                this.screenShake = 12;
                this.score += 1000;
                this.enemyBullets = [];
                this.addFloatingText(p.x, p.y - 38, '🍕 Munchies!!', '#facc15', 22);

                for (let i = this.enemies.length - 1; i >= 0; i--) {
                    this.destroyEnemy(this.enemies[i]);
                }
                this.enemies = [];
                if (this.boss) {
                    this.boss.hp -= Math.max(40, this.boss.maxHp * 0.22);
                    this.updateBossHpUI();
                    if (this.boss.hp <= 0) this.defeatBoss();
                }
            } else {
                sound.playPowerUp(item.id === 'skull' || item.id === 'rainbow');
                this.addFloatingText(p.x, p.y - 35, item.label, item.color, 17);

                switch (item.id) {
                    case 'leaf':
                        p.wayCount = Math.min(5, p.wayCount + 1);
                        break;
                    case 'joint':
                        p.fireRate = Math.max(0.09, p.fireRate * 0.84);
                        p.bulletSpeed = Math.min(720, p.bulletSpeed + 35);
                        break;
                    case 'cookie':
                        p.speed = Math.min(480, p.speed + 25);
                        this.score += 500;
                        break;
                    case 'mushroom':
                        p.mushroomTimer = 9.0;
                        break;
                    case 'rainbow':
                        p.rainbowTimer = 10.0;
                        break;
                    case 'sunglasses':
                        p.shieldTimer = 9.0;
                        break;
                    case 'bear':
                        if (p.bears < 2) {
                            p.bearColors[p.bears] = BEAR_COLORS[Math.floor(Math.random() * BEAR_COLORS.length)];
                            p.bears++;
                        } else {
                            this.score += 800;
                        }
                        break;
                    case 'skull':
                        p.life = Math.min(p.maxLife, p.life + 1);
                        break;
                }
            }
            this.updateHUD();
        }

        updateParticlesAndTexts(dt) {
            for (let i = this.particles.length - 1; i >= 0; i--) {
                const pt = this.particles[i];
                pt.x += pt.vx * dt;
                pt.y += pt.vy * dt;
                pt.life -= dt;
                if (pt.life <= 0) this.particles.splice(i, 1);
            }
            for (let i = this.floatingTexts.length - 1; i >= 0; i--) {
                const ft = this.floatingTexts[i];
                ft.y -= 35 * dt;
                ft.life -= dt;
                if (ft.life <= 0) this.floatingTexts.splice(i, 1);
            }
        }

        // ==========================================
        // 5. Canvas リッチ描画処理
        // ==========================================
        draw() {
            const ctx = this.ctx;
            ctx.save();

            if (this.screenShake > 0) {
                const sx = (Math.random() - 0.5) * this.screenShake;
                const sy = (Math.random() - 0.5) * this.screenShake;
                ctx.translate(sx, sy);
            }

            // 1. サイケデリック背景描画
            this.drawBackground(ctx);

            if (this.state === 'PLAYING' || this.state === 'PAUSED' || this.state === 'GAMEOVER') {
                // 2. 煙の弾描画
                this.drawSmokeBullets(ctx);

                // 3. アイテム描画
                this.drawItems(ctx);

                // 4. ザコ敵描画
                this.drawEnemies(ctx);

                // 5. ボス描画
                if (this.boss) this.drawBoss(ctx);

                // 6. 主人公「ボングくん」＆デッドベア描画
                if (this.state === 'PLAYING' || this.state === 'PAUSED') this.drawPlayer(ctx);

                // 7. 敵弾描画
                this.drawEnemyBullets(ctx);

                // 8. パーティクル＆ポップアップテキスト描画
                this.drawParticlesAndTexts(ctx);

                // ピザ（Munchies!）発動時のフラッシュ演出
                if (this.munchiesFlash > 0) {
                    ctx.fillStyle = `rgba(254, 240, 138, ${this.munchiesFlash * 0.55})`;
                    ctx.fillRect(0, 0, this.width, this.height);
                }
            }

            ctx.restore();
        }

        drawBackground(ctx) {
            const grad = ctx.createLinearGradient(0, 0, 0, this.height);
            grad.addColorStop(0, `hsl(${(this.bgHue + 260) % 360}, 65%, 10%)`);
            grad.addColorStop(0.5, `hsl(${(this.bgHue + 290) % 360}, 60%, 14%)`);
            grad.addColorStop(1, `hsl(${(this.bgHue + 320) % 360}, 70%, 9%)`);
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, this.width, this.height);

            for (const c of this.tieDyeClouds) {
                const rGrad = ctx.createRadialGradient(c.x, c.y, 5, c.x, c.y, c.radius);
                rGrad.addColorStop(0, `hsla(${c.hue}, 90%, 55%, 0.14)`);
                rGrad.addColorStop(0.6, `hsla(${(c.hue + 60) % 360}, 85%, 45%, 0.06)`);
                rGrad.addColorStop(1, 'rgba(0,0,0,0)');
                ctx.fillStyle = rGrad;
                ctx.beginPath();
                ctx.arc(c.x, c.y, c.radius, 0, Math.PI * 2);
                ctx.fill();
            }

            for (const s of this.stars) {
                ctx.fillStyle = `hsla(${(s.hue + this.bgHue) % 360}, 100%, 80%, 0.75)`;
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        drawPlayer(ctx) {
            const p = this.player;

            if (p.invulnTimer > 0 && Math.floor(p.invulnTimer * 16) % 2 === 0) {
                ctx.globalAlpha = 0.45;
            }

            if (p.bears >= 1) this.drawDeadBear(ctx, p.x - 34, p.y + 8, p.bearColors[0], p.animPhase);
            if (p.bears >= 2) this.drawDeadBear(ctx, p.x + 34, p.y + 8, p.bearColors[1], p.animPhase + 1.5);

            ctx.save();
            ctx.translate(p.x, p.y);
            const bounce = Math.sin(p.animPhase) * 2;
            ctx.scale(1 + bounce * 0.015, 1 - bounce * 0.015);

            const flaskGrad = ctx.createRadialGradient(-5, 6, 3, 0, 8, 22);
            flaskGrad.addColorStop(0, 'rgba(165, 243, 252, 0.95)');
            flaskGrad.addColorStop(0.6, 'rgba(56, 189, 248, 0.75)');
            flaskGrad.addColorStop(1, 'rgba(14, 165, 233, 0.9)');
            ctx.fillStyle = flaskGrad;
            ctx.beginPath();
            ctx.arc(0, 8, 19, 0, Math.PI * 2);
            ctx.fill();
            ctx.lineWidth = 2.5;
            ctx.strokeStyle = '#e0f2fe';
            ctx.stroke();

            ctx.fillStyle = 'rgba(255,255,255,0.7)';
            ctx.beginPath();
            ctx.arc(-6, 10 + Math.sin(p.animPhase * 2) * 2, 2.5, 0, Math.PI * 2);
            ctx.arc(5, 12 + Math.cos(p.animPhase * 2) * 2, 2, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = 'rgba(186, 230, 253, 0.8)';
            ctx.fillRect(-7, -22, 14, 22);
            ctx.strokeStyle = '#e0f2fe';
            ctx.lineWidth = 2;
            ctx.strokeRect(-7, -22, 14, 22);

            ctx.fillStyle = '#f472b6';
            ctx.beginPath();
            ctx.roundRect(-10, -26, 20, 5, 3);
            ctx.fill();

            ctx.save();
            ctx.translate(14, 4);
            ctx.rotate(0.55);
            ctx.fillStyle = '#94a3b8';
            ctx.fillRect(-2, -10, 4, 12);
            ctx.fillStyle = '#22c55e';
            ctx.beginPath();
            ctx.arc(0, -11, 5, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#f97316';
            ctx.beginPath();
            ctx.arc(0, -12, 2.5 + Math.sin(p.animPhase * 3) * 1, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();

            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(-6, 5, 4.5, 0, Math.PI * 2);
            ctx.arc(6, 5, 4.5, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#1e1b4b';
            ctx.beginPath();
            ctx.arc(-6, 5.5, 2.2, 0, Math.PI * 2);
            ctx.arc(6, 5.5, 2.2, 0, Math.PI * 2);
            ctx.fill();

            ctx.strokeStyle = '#1e1b4b';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(0, 9, 4, 0.1 * Math.PI, 0.9 * Math.PI);
            ctx.stroke();

            ctx.fillStyle = 'rgba(244, 114, 182, 0.65)';
            ctx.beginPath();
            ctx.arc(-11, 8, 2.5, 0, Math.PI * 2);
            ctx.arc(11, 8, 2.5, 0, Math.PI * 2);
            ctx.fill();

            if (p.shieldTimer > 0) {
                ctx.fillStyle = '#0f172a';
                ctx.beginPath();
                ctx.roundRect(-12, 1, 10, 7, 2);
                ctx.roundRect(2, 1, 10, 7, 2);
                ctx.fill();
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 1.5;
                ctx.stroke();

                ctx.strokeStyle = `hsla(${(this.bgHue * 4) % 360}, 100%, 65%, 0.85)`;
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.arc(0, 0, 30 + Math.sin(p.animPhase * 2) * 2, 0, Math.PI * 2);
                ctx.stroke();
            }

            ctx.restore();
            ctx.globalAlpha = 1;
        }

        drawDeadBear(ctx, x, y, color, phase) {
            ctx.save();
            ctx.translate(x, y + Math.sin(phase) * 3);
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(-7, -8, 4.5, 0, Math.PI * 2);
            ctx.arc(7, -8, 4.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(0, 0, 10, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(0, 9, 6, 0, Math.PI);
            ctx.fill();
            ctx.fillStyle = '#000000';
            ctx.beginPath();
            ctx.arc(-3.5, -1, 1.5, 0, Math.PI * 2);
            ctx.arc(3.5, -1, 1.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        drawSmokeBullets(ctx) {
            for (const b of this.bullets) {
                ctx.save();
                ctx.translate(b.x, b.y);

                if (b.isRainbow) {
                    const grad = ctx.createRadialGradient(0, 0, 1, 0, 0, b.radius);
                    grad.addColorStop(0, '#ffffff');
                    grad.addColorStop(0.5, `hsla(${b.hue}, 100%, 65%, 0.9)`);
                    grad.addColorStop(1, `hsla(${(b.hue + 60) % 360}, 100%, 50%, 0)`);
                    ctx.fillStyle = grad;
                } else {
                    const grad = ctx.createRadialGradient(-2, -2, 1, 0, 0, b.radius);
                    grad.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
                    grad.addColorStop(0.6, 'rgba(226, 232, 240, 0.75)');
                    grad.addColorStop(1, 'rgba(148, 163, 184, 0)');
                    ctx.fillStyle = grad;
                }

                ctx.beginPath();
                ctx.arc(0, 0, b.radius, 0, Math.PI * 2);
                ctx.arc(-b.radius * 0.45, b.radius * 0.2, b.radius * 0.65, 0, Math.PI * 2);
                ctx.arc(b.radius * 0.45, b.radius * 0.2, b.radius * 0.65, 0, Math.PI * 2);
                ctx.fill();

                ctx.restore();
            }
        }

        drawEnemies(ctx) {
            for (const e of this.enemies) {
                ctx.save();
                ctx.translate(e.x, e.y);

                if (e.type === 'police') {
                    ctx.fillStyle = '#1d4ed8';
                    ctx.beginPath();
                    ctx.roundRect(-14, 2, 28, 18, 6);
                    ctx.fill();
                    ctx.fillStyle = '#fed7aa';
                    ctx.beginPath();
                    ctx.arc(0, -4, 11, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = '#1e3a8a';
                    ctx.beginPath();
                    ctx.ellipse(0, -13, 14, 6, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = '#facc15';
                    ctx.beginPath();
                    ctx.arc(0, -13, 3, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.strokeStyle = '#000';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.moveTo(-6, -6); ctx.lineTo(-2, -4);
                    ctx.moveTo(6, -6); ctx.lineTo(2, -4);
                    ctx.stroke();
                } else {
                    ctx.fillStyle = '#18181b';
                    ctx.beginPath();
                    ctx.roundRect(-16, 2, 32, 20, 6);
                    ctx.fill();
                    ctx.fillStyle = '#dc2626';
                    ctx.beginPath();
                    ctx.moveTo(0, 4); ctx.lineTo(-3, 15); ctx.lineTo(0, 18); ctx.lineTo(3, 15);
                    ctx.fill();
                    ctx.fillStyle = '#fde68a';
                    ctx.beginPath();
                    ctx.arc(0, -4, 12, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = '#09090b';
                    ctx.fillRect(-10, -7, 8, 5);
                    ctx.fillRect(2, -7, 8, 5);
                    ctx.fillStyle = '#27272a';
                    ctx.beginPath();
                    ctx.ellipse(0, -13, 18, 4, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillRect(-10, -21, 20, 8);
                }

                ctx.restore();
            }
        }

        drawBoss(ctx) {
            const b = this.boss;
            ctx.save();
            ctx.translate(b.x, b.y);

            const pulse = Math.sin(b.phase * 2) * 6;
            const aura = ctx.createRadialGradient(0, 0, 20, 0, 0, b.radius + 25 + pulse);
            aura.addColorStop(0, 'rgba(239, 68, 68, 0.45)');
            aura.addColorStop(1, 'rgba(0, 0, 0, 0)');
            ctx.fillStyle = aura;
            ctx.beginPath();
            ctx.arc(0, 0, b.radius + 25 + pulse, 0, Math.PI * 2);
            ctx.fill();

            if (b.kind === 'patrol') {
                ctx.fillStyle = '#0f172a';
                ctx.beginPath();
                ctx.roundRect(-52, -32, 104, 68, 16);
                ctx.fill();
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(-48, -10, 96, 24);
                const flash = Math.floor(b.phase * 4) % 2 === 0;
                ctx.fillStyle = flash ? '#ef4444' : '#3b82f6';
                ctx.beginPath();
                ctx.roundRect(-24, -42, 20, 12, 4);
                ctx.fill();
                ctx.fillStyle = flash ? '#3b82f6' : '#ef4444';
                ctx.beginPath();
                ctx.roundRect(4, -42, 20, 12, 4);
                ctx.fill();
                ctx.fillStyle = '#facc15';
                ctx.beginPath();
                ctx.arc(-28, 18, 10, 0, Math.PI * 2);
                ctx.arc(28, 18, 10, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#64748b';
                ctx.fillRect(-35, 30, 70, 10);
            } else if (b.kind === 'mafia') {
                ctx.fillStyle = '#1e1b4b';
                ctx.beginPath();
                ctx.roundRect(-50, -10, 100, 50, 18);
                ctx.fill();
                ctx.fillStyle = '#fed7aa';
                ctx.beginPath();
                ctx.arc(0, -10, 34, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#000000';
                ctx.fillRect(-26, -18, 22, 12);
                ctx.fillRect(4, -18, 22, 12);
                ctx.fillStyle = '#312e81';
                ctx.beginPath();
                ctx.ellipse(0, -36, 46, 8, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillRect(-26, -54, 52, 18);
                ctx.fillStyle = '#78350f';
                ctx.save();
                ctx.translate(16, 8);
                ctx.rotate(0.3);
                ctx.fillRect(0, -3, 24, 6);
                ctx.fillStyle = '#ef4444';
                ctx.fillRect(22, -3, 4, 6);
                ctx.restore();
            } else {
                ctx.fillStyle = `hsl(${(this.bgHue * 3) % 360}, 85%, 50%)`;
                ctx.beginPath();
                ctx.ellipse(0, 5, 48, 34, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#0f172a';
                ctx.beginPath();
                ctx.ellipse(0, 12, 32, 18, 0, 0, Math.PI);
                ctx.fill();
                const bladeW = Math.cos(b.phase * 12) * 68;
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 5;
                ctx.beginPath();
                ctx.moveTo(-bladeW, -34);
                ctx.lineTo(bladeW, -34);
                ctx.stroke();
            }

            ctx.restore();
        }

        drawEnemyBullets(ctx) {
            for (const eb of this.enemyBullets) {
                ctx.save();
                ctx.fillStyle = eb.color;
                ctx.shadowColor = eb.color;
                ctx.shadowBlur = 8;
                ctx.beginPath();
                ctx.arc(eb.x, eb.y, eb.radius, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.arc(eb.x, eb.y, eb.radius * 0.45, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        drawItems(ctx) {
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            for (const it of this.items) {
                ctx.save();
                ctx.translate(it.x, it.y);

                ctx.fillStyle = 'rgba(15, 7, 32, 0.75)';
                ctx.strokeStyle = it.color;
                ctx.lineWidth = 2.5;
                ctx.shadowColor = it.color;
                ctx.shadowBlur = 12;
                ctx.beginPath();
                ctx.arc(0, 0, it.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                ctx.shadowBlur = 0;
                ctx.font = it.id === 'skull' ? '18px sans-serif' : '22px sans-serif';
                ctx.fillText(it.emoji, 0, 1);

                ctx.restore();
            }
        }

        drawParticlesAndTexts(ctx) {
            for (const pt of this.particles) {
                ctx.save();
                ctx.globalAlpha = Math.max(0, pt.life / pt.maxLife);
                ctx.fillStyle = pt.color;
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, pt.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            ctx.textAlign = 'center';
            for (const ft of this.floatingTexts) {
                ctx.save();
                ctx.globalAlpha = Math.min(1, (ft.life / ft.maxLife) * 1.5);
                ctx.font = `900 ${ft.size}px 'Fredoka', 'Noto Sans JP', sans-serif`;
                ctx.strokeStyle = '#090314';
                ctx.lineWidth = 4;
                ctx.strokeText(ft.text, ft.x, ft.y);
                ctx.fillStyle = ft.color;
                ctx.fillText(ft.text, ft.x, ft.y);
                ctx.restore();
            }
        }
    }

    // ウィンドウ読み込み完了後にゲーム初期化
    window.onload = () => {
        window.game = new TripShooterGame();
    };
    <\/script>
