function rollChestItem() {
  const total = CHEST_LOOT.reduce((a, e) => a + e[1], 0);
  let r = Math.random() * total;
  for (const [key, w] of CHEST_LOOT) { r -= w; if (r <= 0) return key; }
  return "tonic";
}

function spawnChestsFor(spotKey) {
  const def = DUNGEONS[spotKey];
  const chests = {};
  if (!def || !def.grid) return chests;
  const candidates = [];
  for (let y = 0; y < def.grid.length; y++) {
    for (let x = 0; x < def.grid[y].length; x++) {
      if (def.grid[y][x] !== 0) continue;
      if (x === def.spawn.x && y === def.spawn.y) continue;
      candidates.push(`${x},${y}`);
    }
  }
  const count = Math.min(candidates.length, 2 + Math.floor(Math.random() * 2));
  for (let i = 0; i < count; i++) {
    const idx = Math.floor(Math.random() * candidates.length);
    const k = candidates.splice(idx, 1)[0];
    chests[k] = rollChestItem();
  }
  return chests;
}

function createInitialDungeonStates() {
  const out = {};
