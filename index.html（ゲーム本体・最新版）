// ボングくんの大冒険：単体版HTMLをそのままiframeで読み込む（中身は一切改変しない）
// ボングくんの大冒険：埋め込んだ単体版(bongSrc)のHTMLとスクリプトを、書き換えずにそのまま取り出して動かす。
// iframeは使わない。document/window/タイマーだけを包んで、閉じるときに完全に片付ける。
let bongStopFn = null;

function initBongGame() {
  stopBongGame();
  const host = document.getElementById("bong-host");
  if (!host) return;

  const raw = document.getElementById("bongSrc").textContent.replace(/<\\\/script>/g, "<\/" + "script>");
  const doc = new DOMParser().parseFromString(raw, "text/html");
  const wrapper = doc.getElementById("game-wrapper");
  const scripts = Array.from(doc.querySelectorAll("script:not([src])"));
  const code = scripts.length ? scripts[scripts.length - 1].textContent : "";
  if (!wrapper || !code) { host.textContent = "ゲームを読み込めませんでした。"; return; }

  if (!document.getElementById("bongStyle")) {
    const css = Array.from(doc.querySelectorAll("style")).map(s => s.textContent).join("\n")
      .replace(/\*\s*\{[^}]*\}/, "")
      .replace(/body,\s*html\s*\{[^}]*\}/, "");
    const st = document.createElement("style");
    st.id = "bongStyle";
    st.textContent = css +
      "\n:where(#game-wrapper) *{user-select:none;-webkit-user-select:none;touch-action:none}" +
      "\n:where(#game-wrapper) button{background:transparent;border:0 solid;padding:0;font:inherit;color:inherit;border-radius:0}" +
      "\nbody.bong-playing #topHud,body.bong-playing .nav-tabs,body.bong-playing #logBox,body.bong-playing .sub-tabs-4,body.bong-playing #barBody>.section-title{display:none}";
    document.head.appendChild(st);
  }

  window.game = null;
  document.body.classList.add("bong-open");
  host.style.cssText = "position:relative;flex:1 1 auto;min-height:0;";
  host.innerHTML = wrapper.outerHTML;

  const listeners = [], intervals = [];
  let alive = true, onloadFn = null;
  const winProxy = new Proxy(window, {
    get(t, k) {
      if (k === "addEventListener") return (type, fn, opt) => { t.addEventListener(type, fn, opt); listeners.push([type, fn, opt]); };
      const v = t[k];
      return typeof v === "function" ? v.bind(t) : v;
    },
    set(t, k, v) { if (k === "onload") { onloadFn = v; return true; } t[k] = v; return true; }
  });
  const docStub = { getElementById: (id) => host.querySelector("#" + id) };
  const raf = (fn) => (alive ? requestAnimationFrame(fn) : 0);
  const si = (fn, ms) => { const id = setInterval(fn, ms); intervals.push(id); return id; };

  let api;
  try {
    api = new Function("document", "window", "requestAnimationFrame", "setInterval",
      code + "\n;return { sound: sound };")(docStub, winProxy, raf, si);
  } catch (e) {
    host.textContent = "ゲームの起動に失敗しました：" + e.message;
    return;
  }

  let wasPlaying = false;
  intervals.push(setInterval(() => {
    const g = window.game;
    const playing = !!(alive && g && (g.state === "PLAYING" || g.state === "PAUSED"));
    document.body.classList.toggle("bong-playing", playing);
    if (playing && !wasPlaying) window.scrollTo(0, 0);
    wasPlaying = playing;
  }, 150));

  bongStopFn = () => {
    alive = false;
    document.body.classList.remove("bong-playing");
    listeners.forEach(([t, fn, o]) => window.removeEventListener(t, fn, o));
    intervals.forEach(id => clearInterval(id));
    try { api.sound.stopBGM(true); if (api.sound.ctx) api.sound.ctx.close().catch(() => {}); } catch (_) {}
    try { if (window.speechSynthesis) window.speechSynthesis.cancel(); } catch (_) {}
  };

  // Tailwindのスタイルが新しい要素に反映されてから起動し、サイズを再計算させる
  requestAnimationFrame(() => requestAnimationFrame(() => {
    if (!alive || !onloadFn) return;
    onloadFn();
    window.dispatchEvent(new Event("resize"));
    setTimeout(() => { if (alive) window.dispatchEvent(new Event("resize")); }, 300);
  }));
}

function stopBongGame() {
  document.body.classList.remove("bong-open");
  if (bongStopFn) { bongStopFn(); bongStopFn = null; }
  const host = document.getElementById("bong-host");
  if (host) host.innerHTML = "";
}

render();
syncCurrentBgmMode();
refreshTitleButtons();
window.addEventListener("beforeunload", () => saveAutosave());
document.addEventListener("visibilitychange", () => { if (document.visibilityState === "hidden") saveAutosave(); });
["pointerdown", "keydown"].forEach(ev => document.addEventListener(ev, () => bgm.ensureCtx(), { passive: true }));
</script>
